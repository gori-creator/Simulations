{
  "name": "mint-simulationen",
  "version": "0.1.0",
  "private": true,
  "description": "Kostenlose, interaktive Simulationen für den Mathematik- und Physikunterricht (DE/EN).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
