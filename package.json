    "verify": "npm run check && npm run test && npm run build",
    "bildtests": "node scripts/bildtests.mjs",
    "lehrplan:luecken": "vitest run tests/lehrplan-luecken.test.ts",
    "new:sim": "node scripts/new-simulation.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.5",
    "astro": "^7.4.2",
    "katex": "^0.19.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
