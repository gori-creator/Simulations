---
// Formel-Styles nur auf Simulationsseiten (nur dort gibt es Formeln). Als eigene Datei im <head>
// vor global.css, damit global.css sie überschreiben kann; ein normaler Import gälte für alle Seiten der Route.
import katexCss from 'katex/dist/katex.min.css?url';
import { getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import KmkList from '../components/KmkList.astro';
import SimShot from '../components/SimShot.astro';
import SimThumb from '../components/SimThumb.astro';
import SimCard from '../components/SimCard.astro';
import SimulationShell from '../components/SimulationShell.astro';
import { getArea, getSimulation, getSubject, getTopic, readySimulations } from '../curriculum';
import { referencesFor, unitAnchor } from '../curriculum/lehrplaene';
import { regionIdOf } from '../lib/region';
import type { Lang } from '../i18n/config';
import { formatGrades, t } from '../i18n/utils';
import { SITE } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { bannerStyle, SECTION_KEYS, sectionFile, type SectionKey } from '../lib/page-art';
import { alternates, href } from '../lib/routes';
import { previewFile } from '../lib/sim-shots';
import { hasShot } from '../lib/sim-shots';

interface Props {
  lang: Lang;
  simId: string;
}

const { lang, simId } = Astro.props;
const sim = getSimulation(simId);
const subject = getSubject(sim.subject);
const area = getArea(sim.subject, sim.area);
const topic = getTopic(sim.subject, sim.area, sim.topic);
const related = readySimulations().filter((s) => s.area === sim.area && s.id !== sim.id);
const references = referencesFor(simId);
const curriculaRefs = [...new Set(references.map((r) => r.curriculum))].map((curriculum) => ({
  curriculum,
  refs: references.filter((r) => r.curriculum === curriculum),
}));

// Lernmaterial: zuerst in der gewählten Sprache, sonst Deutsch
const texts = await getCollection('simulationTexts');
const entry = texts.find((e) => e.id === `${lang}/${simId}`) ?? texts.find((e) => e.id === `de/${simId}`);
const isFallback = !!entry && !entry.id.startsWith(`${lang}/`);
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const toc = rendered?.headings.filter((h) => h.depth === 2) ?? [];

// Kopfbereich: Bannerbild des Bereichs (docs/BEREICHSBILDER.md), sonst das Vorschaubild der Simulation
const banner = await bannerStyle(sim.area);
const preview = banner ? null : previewFile(simId);
// Vorschaubild beim Teilen: das Bild der Simulation im Format 1200 × 630
const ogFile = previewFile(simId);
const ogImg = ogFile ? await getImage({ src: (await ogFile()).default, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 }) : null;
const previewImg = preview ? await getImage({ src: (await preview()).default, width: 720, height: 405, fit: 'cover', format: 'webp', quality: 80 }) : null;

// Anzahl der Aufgaben: Unterüberschriften im dritten Abschnitt („Aufgaben“)
const headings = rendered?.headings ?? [];
const tasksStart = headings.indexOf(toc[2]!);
const tasksEnd = toc[3] ? headings.indexOf(toc[3]) : headings.length;
const taskCount = tasksStart >= 0 ? headings.slice(tasksStart + 1, tasksEnd).filter((h) => h.depth === 3).length : 0;

// Abschnitts-Illustrationen (optional; ohne Bild zeichnet das Skript ein Symbol)
const artKeys: SectionKey[] = [...SECTION_KEYS, 'weiter-lernen'];
const sectionArt = Object.fromEntries(
  await Promise.all(
    artKeys.map(async (key) => {
      const file = sectionFile(key);
      return [key, file ? (await getImage({ src: (await file()).default, width: 168, format: 'webp' })).src : null] as const;
    }),
  ),
);

// Weiter lernen: die nächsten Simulationen im Bereich (in Lehrplan-Reihenfolge, am Ende von vorn)
const areaSims = readySimulations().filter((s) => s.area === sim.area && s.subject === sim.subject);
const here = areaSims.findIndex((s) => s.id === simId);
const nextSims = [...areaSims.slice(here + 1), ...areaSims.slice(0, Math.max(0, here))].slice(0, 3);
// Strukturierte Daten (schema.org/LearningResource) für Suchmaschinen
const jsonLd = {
  '@type': 'LearningResource',
  name: sim.title[lang],
  description: entry?.data.description ?? sim.summary?.[lang],
  url: new URL(href(lang, { kind: 'simulation', id: simId }), SITE.url).href,
  inLanguage: lang,
  learningResourceType: lang === 'de' ? 'Interaktive Simulation' : 'Interactive simulation',
  educationalLevel: formatGrades(lang, sim.grades, sim.uni),
  about: [subject.title[lang], area.title[lang], topic.title[lang]],
  isAccessibleForFree: true,
  publisher: { '@type': 'Organization', name: SITE.name[lang], url: `${SITE.url}/` },
};
const materialLabels = {
  tried: t(lang, 'material.tried'),
  markTried: t(lang, 'material.markTried'),
};
---

<BaseLayout
  lang={lang}
  title={`${sim.title[lang]} – ${lang === 'de' ? 'Interaktive Simulation' : 'Interactive simulation'}`}
  description={entry?.data.description ?? sim.summary?.[lang]}
  jsonLd={jsonLd}
  ogImage={ogImg?.src}
  alternates={alternates({ kind: 'simulation', id: simId })}
  section={sim.subject}
  stylesheets={[katexCss]}
>
  <div class:list={['container', `subject-${sim.subject}`]}>
    <Breadcrumbs
      lang={lang}
      items={[
        { label: t(lang, 'nav.home'), href: href(lang, { kind: 'home' }) },
        { label: subject.title[lang], href: href(lang, { kind: 'subject', subject: sim.subject }) },
        { label: area.title[lang], href: href(lang, { kind: 'area', subject: sim.subject, area: sim.area }) },
        { label: sim.title[lang] },
      ]}
    />
    <header class:list={['page-head', 'sim-hero', { 'sim-hero--banner': banner }]} style={banner ?? undefined}>
      <div class="sim-hero__text">
        <p class="page-head__eyebrow">
          <span>{subject.title[lang]}</span><span aria-hidden="true">·</span><span>{formatGrades(lang, sim.grades, sim.uni)}</span>
        </p>
        <h1>{sim.title[lang]}</h1>
        {sim.summary && <p class="lead">{sim.summary[lang]}</p>}
        {
          sim.community && (
            <p class="sim-community">
              <span class="badge badge--community">{t(lang, 'status.community')}</span>
              <span>
                {t(lang, 'status.communityBy', { author: sim.community.author })}{' '}
                <a href={href(lang, { kind: 'page', page: 'contribute' })}>{t(lang, 'status.communityHow')}</a>
              </span>
            </p>
          )
        }
        <ul class="sim-hero__chips">
          <li>
            <a href={href(lang, { kind: 'area', subject: sim.subject, area: sim.area })}>{area.title[lang]}</a>
          </li>
          <li>{topic.title[lang]}</li>
          {taskCount > 0 && <li>{taskCount === 1 ? t(lang, 'material.taskCountOne') : t(lang, 'material.taskCount', { n: taskCount })}</li>}
        </ul>
      </div>
      {
        previewImg && (
          <div class="sim-hero__art" aria-hidden="true">
            <img src={previewImg.src} width="720" height="405" alt="" decoding="async" fetchpriority="high" />
          </div>
        )
      }
    </header>

    <div class="sim-window">
      <div class="sim-window__bar" aria-hidden="true">
        <span class="sim-window__lights"><i></i><i></i><i></i></span>
        <span class="sim-window__title">{subject.title[lang]} – {sim.title[lang]}</span>
      </div>
      <SimulationShell lang={lang} simId={simId} title={sim.title[lang]} />
    </div>

    <div class="sim-page__material">
      <article class="prose" data-sim-material data-sim-id={simId} data-art={JSON.stringify(sectionArt)} data-labels={JSON.stringify(materialLabels)}>
        {isFallback && <p class="note note--warning">{t(lang, 'material.translationMissing')}</p>}
        {Content && <Content />}
      </article>

      <aside class="sim-page__aside">
        {
          toc.length > 0 && (
            <nav class="aside-box aside-box--toc" aria-label={t(lang, 'material.toc')}>
              <h2>{t(lang, 'material.toc')}</h2>
              <ul>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <section class="aside-box" style="position:static">
          <h2>{t(lang, 'material.curriculum')}</h2>
          <dl>
            <dt>{t(lang, 'material.grades')}</dt>
            <dd>{formatGrades(lang, sim.grades, sim.uni)}</dd>
            <dt>{t(lang, 'material.topic')}</dt>
            <dd>
              <a href={`${href(lang, { kind: 'area', subject: sim.subject, area: sim.area })}#${topic.id}`}>{topic.title[lang]}</a>
            </dd>
            {
              sim.kmk && sim.kmk.length > 0 && (
                <>
                  <dt>KMK</dt>
                  <dd>
                    <KmkList lang={lang} ids={sim.kmk} />
                  </dd>
                </>
              )
            }
          </dl>
        </section>
        {
          curriculaRefs.length > 0 && (
            <>
              {/* Gewähltes Bundesland als eigener Kasten, alle Länder zusammen zum Aufklappen */}
              {curriculaRefs.map(({ curriculum, refs }) => (
                <section class="aside-box" style="position:static" data-region-only={regionIdOf(curriculum)}>
                  <span class="badge badge--region" style="margin-bottom:8px">{t(lang, 'region.current')}</span>
                  <h2>{t(lang, 'curriculum.reference', { state: curriculum.state[lang], school: curriculum.schoolType[lang] })}</h2>
                  <ul>
                    {refs.map((r) => (
                      <li>
                        <a href={`${href(lang, { kind: 'grade', curriculum: curriculum.id, grade: r.grade })}#${unitAnchor(r.unit.code)}`}>
                          <strong>{t(lang, 'curriculum.gradeShort', { n: r.label })}</strong> · {r.unit.code} {r.unit.title[lang]}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
              <details
                class="aside-box lp-more"
                style="position:static"
                data-region-hide={curriculaRefs.length === 1 ? regionIdOf(curriculaRefs[0]!.curriculum) : undefined}
              >
                <summary>
                  {t(lang, curriculaRefs.length === 1 ? 'material.inCurriculaOne' : 'material.inCurricula', { n: curriculaRefs.length })}
                </summary>
                {curriculaRefs.map(({ curriculum, refs }) => (
                  <div class="lp-more__item" data-region-hide={regionIdOf(curriculum)}>
                    <h3>{t(lang, 'curriculum.reference', { state: curriculum.state[lang], school: curriculum.schoolType[lang] })}</h3>
                    <ul>
                      {refs.map((r) => (
                        <li>
                          <a href={`${href(lang, { kind: 'grade', curriculum: curriculum.id, grade: r.grade })}#${unitAnchor(r.unit.code)}`}>
                            <strong>{t(lang, 'curriculum.gradeShort', { n: r.label })}</strong> · {r.unit.code} {r.unit.title[lang]}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </details>
            </>
          )
        }
        {
          related.length > 0 && (
            <section class="aside-box" style="position:static">
              <h2>{t(lang, 'material.related')}</h2>
              <ul class="related-sims">
                {related.map((r) => (
                  <li>
                    <a class="related-sim" href={href(lang, { kind: 'simulation', id: r.id })}>
                      <span class:list={['related-sim__thumb', { 'card__thumb--shot': hasShot(r.id) }]}>
                        {hasShot(r.id) ? <SimShot id={r.id} small /> : <SimThumb kind={r.thumb} id={r.id} />}
                      </span>
                      <span class="related-sim__title">{r.title[lang]}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        <section class="aside-box" style="position:static">
          <h2>{t(lang, 'material.feedback')}</h2>
          <p>{t(lang, 'material.feedbackLead')}</p>
          <a class="btn" href={`${href(lang, { kind: 'page', page: 'contact' })}?sim=${encodeURIComponent(simId)}&von=${encodeURIComponent(href(lang, { kind: 'simulation', id: simId }))}`}>
            {t(lang, 'nav.contact')}
          </a>
        </section>
      </aside>
    </div>

    {
      nextSims.length > 0 && (
        <section class="sim-next" aria-labelledby="sim-next-title">
          <div class="sim-next__head">
            <span class="mat-icon" data-art-key="weiter-lernen" aria-hidden="true">
              {sectionArt['weiter-lernen'] && <img src={sectionArt['weiter-lernen']} alt="" width="84" height="84" loading="lazy" decoding="async" />}
            </span>
            <h2 id="sim-next-title">{t(lang, 'material.next')}</h2>
          </div>
          <div class="card-grid sim-next__grid">
            {nextSims.map((s) => (
              <SimCard lang={lang} sim={s} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  import { initMaterial } from '../lib/sim-material';

  initMaterial();
</script>
