---
// Formel-Styles nur auf Simulationsseiten (nur dort gibt es Formeln). Als eigene Datei im <head>
// vor global.css, damit global.css sie überschreiben kann; ein normaler Import gälte für alle Seiten der Route.
import katexCss from 'katex/dist/katex.min.css?url';
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import KmkList from '../components/KmkList.astro';
import SimShot from '../components/SimShot.astro';
import SimThumb from '../components/SimThumb.astro';
import SimulationShell from '../components/SimulationShell.astro';
import { getArea, getSimulation, getSubject, getTopic, readySimulations } from '../curriculum';
import { referencesFor, unitAnchor } from '../curriculum/lehrplaene';
import { regionIdOf } from '../lib/region';
import type { Lang } from '../i18n/config';
import { formatGrades, t } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { alternates, href } from '../lib/routes';
import { hasShot } from '../lib/sim-shots';

interface Props {
  lang: Lang;
  simId: string;
}

const { lang, simId } = Astro.props;
const sim = getSimulation(simId);
const subject = getSubject(sim.subject);
const area = getArea(sim.subject, sim.area);
const topic = getTopic(sim.subject, sim.area, sim.topic);
const related = readySimulations().filter((s) => s.area === sim.area && s.id !== sim.id);
const references = referencesFor(simId);
const curriculaRefs = [...new Set(references.map((r) => r.curriculum))].map((curriculum) => ({
  curriculum,
  refs: references.filter((r) => r.curriculum === curriculum),
}));

// Lernmaterial: zuerst in der gewählten Sprache, sonst Deutsch
const texts = await getCollection('simulationTexts');
const entry = texts.find((e) => e.id === `${lang}/${simId}`) ?? texts.find((e) => e.id === `de/${simId}`);
const isFallback = !!entry && !entry.id.startsWith(`${lang}/`);
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const toc = rendered?.headings.filter((h) => h.depth === 2) ?? [];
---

<BaseLayout
  lang={lang}
  title={sim.title[lang]}
  description={entry?.data.description ?? sim.summary?.[lang]}
  alternates={alternates({ kind: 'simulation', id: simId })}
  section={sim.subject}
  stylesheets={[katexCss]}
>
  <div class:list={['container', `subject-${sim.subject}`]}>
    <Breadcrumbs
      lang={lang}
      items={[
        { label: t(lang, 'nav.home'), href: href(lang, { kind: 'home' }) },
        { label: subject.title[lang], href: href(lang, { kind: 'subject', subject: sim.subject }) },
        { label: area.title[lang], href: href(lang, { kind: 'area', subject: sim.subject, area: sim.area }) },
        { label: sim.title[lang] },
      ]}
    />
    <header class="page-head">
      <p class="page-head__eyebrow">
        <span>{subject.title[lang]}</span><span aria-hidden="true">·</span><span>{formatGrades(lang, sim.grades, sim.uni)}</span>
      </p>
      <h1>{sim.title[lang]}</h1>
      {sim.summary && <p class="lead">{sim.summary[lang]}</p>}
    </header>

    <SimulationShell lang={lang} simId={simId} title={sim.title[lang]} />

    <div class="sim-page__material">
      <article class="prose" data-sim-material>
        {isFallback && <p class="note note--warning">{t(lang, 'material.translationMissing')}</p>}
        {Content && <Content />}
      </article>

      <aside class="sim-page__aside">
        {
          toc.length > 0 && (
            <nav class="aside-box aside-box--toc" aria-label={t(lang, 'material.toc')}>
              <h2>{t(lang, 'material.toc')}</h2>
              <ul>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <section class="aside-box" style="position:static">
          <h2>{t(lang, 'material.curriculum')}</h2>
          <dl>
            <dt>{t(lang, 'material.grades')}</dt>
            <dd>{formatGrades(lang, sim.grades, sim.uni)}</dd>
            <dt>{t(lang, 'material.topic')}</dt>
            <dd>
              <a href={`${href(lang, { kind: 'area', subject: sim.subject, area: sim.area })}#${topic.id}`}>{topic.title[lang]}</a>
            </dd>
            {
              sim.kmk && sim.kmk.length > 0 && (
                <>
                  <dt>KMK</dt>
                  <dd>
                    <KmkList lang={lang} ids={sim.kmk} />
                  </dd>
                </>
              )
            }
          </dl>
        </section>
        {
          curriculaRefs.length > 0 && (
            <>
              {/* Gewähltes Bundesland als eigener Kasten, alle Länder zusammen zum Aufklappen */}
              {curriculaRefs.map(({ curriculum, refs }) => (
                <section class="aside-box" style="position:static" data-region-only={regionIdOf(curriculum)}>
                  <span class="badge badge--region" style="margin-bottom:8px">{t(lang, 'region.current')}</span>
                  <h2>{t(lang, 'curriculum.reference', { state: curriculum.state[lang], school: curriculum.schoolType[lang] })}</h2>
                  <ul>
                    {refs.map((r) => (
                      <li>
                        <a href={`${href(lang, { kind: 'grade', curriculum: curriculum.id, grade: r.grade })}#${unitAnchor(r.unit.code)}`}>
                          <strong>{t(lang, 'curriculum.gradeShort', { n: r.label })}</strong> · {r.unit.code} {r.unit.title[lang]}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
              <details
                class="aside-box lp-more"
                style="position:static"
                data-region-hide={curriculaRefs.length === 1 ? regionIdOf(curriculaRefs[0]!.curriculum) : undefined}
              >
                <summary>
                  {t(lang, curriculaRefs.length === 1 ? 'material.inCurriculaOne' : 'material.inCurricula', { n: curriculaRefs.length })}
                </summary>
                {curriculaRefs.map(({ curriculum, refs }) => (
                  <div class="lp-more__item" data-region-hide={regionIdOf(curriculum)}>
                    <h3>{t(lang, 'curriculum.reference', { state: curriculum.state[lang], school: curriculum.schoolType[lang] })}</h3>
                    <ul>
                      {refs.map((r) => (
                        <li>
                          <a href={`${href(lang, { kind: 'grade', curriculum: curriculum.id, grade: r.grade })}#${unitAnchor(r.unit.code)}`}>
                            <strong>{t(lang, 'curriculum.gradeShort', { n: r.label })}</strong> · {r.unit.code} {r.unit.title[lang]}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </details>
            </>
          )
        }
        {
          related.length > 0 && (
            <section class="aside-box" style="position:static">
              <h2>{t(lang, 'material.related')}</h2>
              <ul class="related-sims">
                {related.map((r) => (
                  <li>
                    <a class="related-sim" href={href(lang, { kind: 'simulation', id: r.id })}>
                      <span class:list={['related-sim__thumb', { 'card__thumb--shot': hasShot(r.id) }]}>
                        {hasShot(r.id) ? <SimShot id={r.id} small /> : <SimThumb kind={r.thumb} id={r.id} />}
                      </span>
                      <span class="related-sim__title">{r.title[lang]}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        <section class="aside-box" style="position:static">
          <h2>{t(lang, 'material.feedback')}</h2>
          <p>{t(lang, 'material.feedbackLead')}</p>
          <a class="btn" href={`${href(lang, { kind: 'page', page: 'contact' })}?sim=${encodeURIComponent(simId)}&von=${encodeURIComponent(href(lang, { kind: 'simulation', id: simId }))}`}>
            {t(lang, 'nav.contact')}
          </a>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
