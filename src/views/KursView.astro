---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import KursArt from '../components/KursArt.astro';
import type { Lang } from '../i18n/config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { COURSES, COURSES_PUBLIC, getCourse, lessonsOf } from '../kurse';
import { cardArt, worldArt } from '../kurse/art';
import { loadGlossary, loadLesson } from '../kurse/loaders';
import { guideSvg } from '../kurse/engine/guide';
import { badgeRules } from '../kurse/engine/progress';
import { ks } from '../kurse/strings';
import { alternates, href } from '../lib/routes';
import '../styles/kurs.css';

interface Props {
  lang: Lang;
  courseId: string;
}

const { lang, courseId } = Astro.props;
const course = getCourse(courseId);
const lessons = lessonsOf(course);
const ready = lessons.filter((l) => l.status === 'ready');
const first = ready[0];
const badges = badgeRules(course);
const cards = ready.filter((l) => l.card).sort((a, b) => a.card!.year - b.card!.year);
const others = COURSES.filter((c) => c.id !== course.id);
const lessonHref = (id: string) => href(lang, { kind: 'lesson', course: course.id, lesson: id });
// Optionale Bilder (docs/KI-KURS-BILDER.md); fehlen sie, bleibt die gezeichnete Darstellung.
const worldArts = await Promise.all(course.chapters.map((chapter) => worldArt(course.id, chapter.id)));
const cardArts = new Map(await Promise.all(cards.map(async (lesson) => [lesson.id, await cardArt(course.id, lesson.id)] as const)));
// KI-Wörterbuch (alphabetisch)
const glossary = (await loadGlossary(course.id)).sort((a, b) => a.term[lang].localeCompare(b.term[lang], lang));
// Merksätze für den Spickzettel jeder Welt
const takeaways = new Map(await Promise.all(ready.map(async (lesson) => [lesson.id, (await loadLesson(course.id, lesson.id)).takeaway] as const)));
---

<BaseLayout
  lang={lang}
  title={`${course.title[lang]} – ${course.audience[lang]}`}
  description={course.description[lang]}
  alternates={alternates({ kind: 'course', course: course.id })}
  section="kurs"
  noindex={!COURSES_PUBLIC}
>
  <div class:list={['kurs', `kurs--${course.guide}`]} data-kurs-hub data-course={course.id} data-lang={lang}>
    <div class="container">
      <Breadcrumbs
        lang={lang}
        items={[
          { label: ks(lang, 'home'), href: href(lang, { kind: 'home' }) },
          { label: ks(lang, 'coursesTitle'), href: href(lang, { kind: 'courses' }) },
          { label: course.title[lang] },
        ]}
      />

      <header class="khero">
        <div class="khero__bit" data-hub-bit set:html={guideSvg(course.guide, 'wink', 1, course.guideName)} />
        <div class="khero__text">
          <p class="khero__audience">{course.audience[lang]}</p>
          <h1 class="khero__title">{course.title[lang]}</h1>
          <p class="khero__tagline">{course.tagline[lang]}</p>
          <div class="khero__stats">
            <p class="khero__level"><strong data-hub-level>{ks(lang, 'levelName', { n: 1, name: course.levels[0]![lang] })}</strong></p>
            <div class="kbar" aria-hidden="true"><span class="kbar__fill" data-hub-bar></span></div>
            <p class="khero__meta">
              <span data-hub-xp>{ks(lang, 'xp', { n: 0 })}</span>
              <span data-hub-done>{ks(lang, 'overall', { done: 0, total: ready.length })}</span>
              <span data-hub-streak hidden></span>
            </p>
          </div>
          {
            first && (
              <a class="btn btn--primary btn--lg khero__go" href={lessonHref(first.id)} data-hub-go>
                <span data-hub-go-label>{ks(lang, 'startAt', { title: first.title[lang] })}</span> →
              </a>
            )
          }
          <p class="khero__privacy">🔒 {ks(lang, 'privacy')}</p>
          <p class="khero__other">👩‍🏫 <a href={href(lang, { kind: 'courseGuide', course: course.id })}>{ks(lang, 'teacherGuide')}</a></p>
          {
            others.map((other) => (
              <p class="khero__other">
                {ks(lang, 'otherLevel')} <a href={href(lang, { kind: 'course', course: other.id })}>{other.title[lang]}</a> ({other.audience[lang]})
              </p>
            ))
          }
        </div>
      </header>

      <p class="ktoast" data-hub-toast role="status" hidden></p>

      <ol class="kmap">
        {
          course.chapters.map((chapter, ci) => (
            <li class:list={['kworld', `kchapter--${ci + 1}`, { 'has-art': worldArts[ci] }]} data-world={chapter.id}>
              <header class="kworld__head">
                <KursArt art={worldArts[ci]} class="kworld__art" />
                <span class="kworld__emblem" aria-hidden="true">
                  {chapter.icon}
                </span>
                <div class="kworld__titles">
                  <span class="kworld__no">
                    {ks(lang, 'chapter', { n: ci + 1 })}
                    {chapter.era && ` · ${chapter.era[lang]}`}
                  </span>
                  <h2 class="kworld__title">{chapter.title[lang]}</h2>
                  <p class="kworld__blurb">{chapter.blurb[lang]}</p>
                </div>
                <span class="kworld__count" data-world-count>
                  {ks(lang, 'worldProgress', { done: 0, total: chapter.lessons.filter((l) => l.status === 'ready').length })}
                </span>
              </header>
              <ol class="ktrail" style={`--n: ${chapter.lessons.length}`}>
                {chapter.lessons.map((lesson) => {
                  const entry = lessons.find((l) => l.id === lesson.id)!;
                  return (
                    <li class:list={['ktrail__item', { 'is-boss': lesson.boss }]}>
                      {lesson.status === 'ready' ? (
                        <a class:list={['kstop', { 'kstop--boss': lesson.boss }]} href={lessonHref(lesson.id)} data-lesson={lesson.id} data-title={lesson.title[lang]}>
                          <span class="kstop__node">
                            <span class="kstop__icon" aria-hidden="true">
                              {lesson.icon}
                            </span>
                            <span class="kstop__lock" aria-hidden="true">
                              🔒
                            </span>
                            <span class="kstop__here" aria-hidden="true">
                              {ks(lang, 'youAreHere')}
                            </span>
                          </span>
                          <span class="kstop__stars" aria-hidden="true">
                            <span data-star>★</span>
                            <span data-star>★</span>
                            <span data-star>★</span>
                          </span>
                          <span class="kstop__body">
                            <span class="kstop__no">
                              {entry.no}
                              {lesson.boss && ` · ${ks(lang, 'boss')}`}
                            </span>
                            <strong class="kstop__title">{lesson.title[lang]}</strong>
                            <span class="kstop__teaser">{lesson.teaser[lang]}</span>
                            <span class="kstop__meta">
                              <span>{ks(lang, 'minutes', { n: lesson.minutes })}</span>
                              {lesson.card && <span class="kstop__year">{lesson.card.year}</span>}
                              <span class="visually-hidden" data-state />
                            </span>
                          </span>
                        </a>
                      ) : (
                        <span class="kstop kstop--soon">
                          <span class="kstop__node">
                            <span class="kstop__icon" aria-hidden="true">
                              {lesson.icon}
                            </span>
                          </span>
                          <span class="kstop__body">
                            <span class="kstop__no">{entry.no}</span>
                            <strong class="kstop__title">{lesson.title[lang]}</strong>
                            <span class="kstop__teaser">{lesson.teaser[lang]}</span>
                            <span class="kstop__meta">{ks(lang, 'soon')}</span>
                          </span>
                        </span>
                      )}
                    </li>
                  );
                })}
              </ol>
              <div class="kworld__tools">
                <details class="knotes">
                  <summary>
                    📝 {ks(lang, 'notesTitle')} <span class="knotes__count" data-notes-count />
                  </summary>
                  <ol class="knotes__list">
                    {chapter.lessons
                      .filter((lesson) => lesson.status === 'ready' && takeaways.get(lesson.id))
                      .map((lesson) => (
                        <li class="knotes__item" data-note={lesson.id}>
                          <span class="knotes__icon" aria-hidden="true">
                            {lesson.icon}
                          </span>
                          <span class="knotes__body">
                            <strong>{lesson.title[lang]}</strong>
                            <span class="knotes__text">{takeaways.get(lesson.id)![lang]}</span>
                            <span class="knotes__locked">🔒 {ks(lang, 'noteLocked')}</span>
                          </span>
                        </li>
                      ))}
                  </ol>
                </details>
                <button class="btn kworld__review" type="button" data-review={chapter.id} data-review-title={ks(lang, 'reviewTitle', { world: chapter.title[lang] })} disabled>
                  🔁 {ks(lang, 'reviewButton')}
                </button>
                <span class="kworld__due" data-review-due hidden>
                  ⏰ {ks(lang, 'reviewDue')}
                </span>
                <span class="kworld__reviewed" data-review-info />
              </div>
            </li>
          ))
        }
      </ol>

      <dialog class="kreview" data-review-dialog aria-labelledby="kreview-title">
        <div class="kreview__inner">
          <header class="kreview__head">
            <h2 class="kreview__title" id="kreview-title" data-review-heading>{ks(lang, 'reviewButton')}</h2>
            <button class="btn btn--ghost kreview__close" type="button" data-review-close aria-label={ks(lang, 'close')}>✕</button>
          </header>
          <div class="kreview__body" data-review-body />
        </div>
      </dialog>

      {
        cards.length > 0 && (
          <section class="kalbum" aria-labelledby="kalbum-title">
            <h2 id="kalbum-title">
              🃏 {ks(lang, 'album')} <span class="kalbum__count" data-album-count />
            </h2>
            <p class="kalbum__text">{ks(lang, 'albumText')}</p>
            <ol class="kalbum__list">
              {cards.map((lesson) => {
                const entry = lessons.find((l) => l.id === lesson.id)!;
                return (
                  <li class:list={['kcardx', `kchapter--${entry.chapterNo}`, { 'has-art': cardArts.get(lesson.id) }]} data-card={lesson.id}>
                    <KursArt art={cardArts.get(lesson.id)} class="kcardx__art" />
                    <span class="kcardx__year">{lesson.card!.year}</span>
                    <h3 class="kcardx__title">{lesson.card!.title[lang]}</h3>
                    <p class="kcardx__text">{lesson.card!.text[lang]}</p>
                    {lesson.card!.source && <p class="kcardx__source">📚 {typeof lesson.card!.source === 'string' ? lesson.card!.source : lesson.card!.source[lang]}</p>}
                    <p class="kcardx__locked">{ks(lang, 'cardLocked', { title: lesson.title[lang] })}</p>
                    <span class="kcardx__icon" aria-hidden="true">
                      {lesson.icon}
                    </span>
                  </li>
                );
              })}
            </ol>
          </section>
        )
      }

      {
        glossary.length > 0 && (
          <section class="kwords">
            <details>
              <summary>
                <h2 id="kwords-title">
                  📖 {ks(lang, 'glossary')} <span class="kwords__count">({glossary.length})</span>
                </h2>
              </summary>
              <p class="kalbum__text">{ks(lang, 'glossaryText')}</p>
              <dl class="kwords__list">
                {glossary.map((entry) => (
                  <div class="kwords__item">
                    <dt>{entry.term[lang]}</dt>
                    <dd>{entry.text[lang]}</dd>
                  </div>
                ))}
              </dl>
            </details>
          </section>
        )
      }

      <section class="kbadges" aria-labelledby="kbadges-title">
        <h2 id="kbadges-title">{ks(lang, 'badges')} <span class="kbadges__count" data-hub-badges></span></h2>
        <ul class="kbadges__list">
          {
            badges.map((badge) => (
              <li class="kbadge" data-badge={badge.id}>
                <span class="kbadge__icon" aria-hidden="true">
                  {badge.icon}
                </span>
                <span>
                  <strong>{badge.title[lang]}</strong>
                  <span>{badge.text[lang]}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="kcertbox" aria-labelledby="kcert-title">
        <h2 id="kcert-title">🏅 {ks(lang, 'certTitle')}</h2>
        <p class="kalbum__text" data-cert-hint>{ks(lang, 'certHint')}</p>
        <div class="ksettings__row">
          <input class="input" type="text" maxlength="60" autocomplete="off" data-cert-name aria-label={ks(lang, 'certName')} placeholder={ks(lang, 'certName')} />
          <button class="btn btn--primary" type="button" data-cert-print>🖨️ {ks(lang, 'certPrint')}</button>
        </div>
        <p class="muted kcertbox__note">{ks(lang, 'certPrivacy')}</p>
      </section>

      <!-- Druckansicht der Urkunde (nur beim Drucken sichtbar, Inhalt setzt hub.ts) -->
      <section class="kcert" data-cert aria-hidden="true">
        <div class="kcert__frame">
          <div class="kcert__guide" data-cert-guide />
          <p class="kcert__kind" data-cert-kind />
          <p class="kcert__name" data-cert-who />
          <p class="kcert__text" data-cert-text />
          <ul class="kcert__facts" data-cert-facts />
          <p class="kcert__worlds" data-cert-worlds />
          <p class="kcert__foot" data-cert-foot />
        </div>
      </section>

      <details class="ksettings">
        <summary>⚙️ {ks(lang, 'settings')}</summary>
        <div class="ksettings__body">
          <label class="switch">
            <input class="switch__input" type="checkbox" role="switch" data-hub-free />
            <span class="switch__track" aria-hidden="true"></span>
            <span class="switch__label">{ks(lang, 'freeMode')}</span>
          </label>
          <p class="muted">{ks(lang, 'freeModeHint')}</p>

          <h3>{ks(lang, 'saveTitle')}</h3>
          <p class="muted">{ks(lang, 'saveText')}</p>
          <div class="ksettings__row">
            <input class="input" type="text" readonly data-hub-code aria-label={ks(lang, 'saveTitle')} />
            <button class="btn" type="button" data-hub-copy>{ks(lang, 'saveCopy')}</button>
          </div>
          <div class="ksettings__row">
            <input class="input" type="text" data-hub-import aria-label={ks(lang, 'loadLabel')} placeholder={ks(lang, 'loadLabel')} />
            <button class="btn" type="button" data-hub-load>{ks(lang, 'loadButton')}</button>
          </div>
          <p class="ksettings__msg" data-hub-msg role="status"></p>
          <button class="btn btn--ghost ksettings__reset" type="button" data-hub-reset>🗑️ {ks(lang, 'resetButton')}</button>
        </div>
      </details>
    </div>
  </div>
</BaseLayout>

<script>
  import { initHub } from '../kurse/engine/hub';

  const root = document.querySelector<HTMLElement>('[data-kurs-hub]');
  if (root) initHub(root);
</script>
