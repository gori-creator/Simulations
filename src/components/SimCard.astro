---
import { getSubject } from '../curriculum';
import type { SimulationEntry } from '../curriculum/types';
import type { Lang } from '../i18n/config';
import { t } from '../i18n/utils';
import { regionGradeLabels, regionOrders, regionOrderStyle, regionsOf } from '../lib/region';
import { href } from '../lib/routes';
import GradeBadge from './GradeBadge.astro';
import { hasShot } from '../lib/sim-shots';
import SimShot from './SimShot.astro';
import SimThumb from './SimThumb.astro';

interface Props {
  lang: Lang;
  sim: SimulationEntry;
  showSubject?: boolean;
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { lang, sim, showSubject = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const ready = sim.status === 'ready';
const subject = getSubject(sim.subject);
const searchText = [sim.title[lang], sim.summary?.[lang] ?? '', ...(sim.keywords?.[lang] ?? []), subject.title[lang]]
  .join(' ')
  .toLowerCase();
// Einstellung „Bundesland“: Sortierschlüssel je Land (CSS `order` und Skript) und Etikett mit der Jahrgangsstufe
const orders = regionOrders(sim.id);
const regionBadges = regionsOf(lang)
  .map((region) => ({ region, grades: regionGradeLabels(sim.id, region.id) }))
  .filter((r) => r.grades.length > 0);
---

<article
  class:list={['card', `subject-${sim.subject}`, ready ? 'card--link' : 'card--planned']}
  data-sim-card
  data-subject={sim.subject}
  data-status={sim.status}
  data-grade-from={sim.grades[0]}
  data-grade-to={sim.uni ? Math.max(sim.grades[1], 14) : sim.grades[1]}
  data-search={searchText}
  data-region-order={Object.keys(orders).length ? JSON.stringify(orders) : undefined}
  style={regionOrderStyle(orders)}
>
  <div class:list={['card__thumb', { 'card__thumb--shot': ready && hasShot(sim.id) }]}>
    {ready && hasShot(sim.id) ? <SimShot id={sim.id} /> : <SimThumb kind={sim.thumb} id={sim.id} />}
  </div>
  <div class="card__body">
    <Heading class="card__title">
      {ready ? <a class="card__link" href={href(lang, { kind: 'simulation', id: sim.id })}>{sim.title[lang]}</a> : sim.title[lang]}
    </Heading>
    {sim.summary && <p class="card__text">{sim.summary[lang]}</p>}
    <div class="card__meta">
      {showSubject && <span class={`badge badge--subject-${sim.subject}`}>{subject.title[lang]}</span>}
      <GradeBadge lang={lang} grades={sim.grades} uni={sim.uni} />
      {
        regionBadges.map(({ region, grades }) => (
          <span class="badge badge--region" data-region-only={region.id}>
            {t(lang, grades.length > 1 ? 'region.cardGrades' : 'region.cardGrade', { state: region.name[lang], grades: grades.join(', ') })}
          </span>
        ))
      }
      {!ready && <span class="badge">{t(lang, 'status.planned')}</span>}
    </div>
  </div>
</article>
