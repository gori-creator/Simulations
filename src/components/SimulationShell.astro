---
import type { Lang } from '../i18n/config';
import { t } from '../i18n/utils';
import Icon from './Icon.astro';

/**
 * HTML-Gerüst einer Simulation. Das Leben (Regler, Zeichnen, Teilen …)
 * kommt aus src/sim-core/host.ts, das hier per Skript gestartet wird.
 */
interface Props {
  lang: Lang;
  simId: string;
  title: string;
}

const { lang, simId, title } = Astro.props;
const dialogTitleId = `share-title-${simId}`;
---

<section class="sim" data-sim-root data-sim-id={simId} data-lang={lang} aria-label={title}>
  <div class="sim__layout">
    <div class="sim__main">
      <div class="sim__stage" data-sim-stage>
        <p class="sim__status" data-sim-status>{t(lang, 'sim.loading')}</p>
        <noscript><p class="sim__status">{t(lang, 'sim.noscript')}</p></noscript>
      </div>
      <div class="sim__actions" data-sim-actions hidden></div>
      <div class="sim__toolbar" role="group" aria-label={t(lang, 'sim.toolbar')}>
        <div class="sim__toolbar-group">
          <div class="sim__toolbar-group" data-sim-anim hidden>
            <button class="btn btn--primary" type="button" data-action="play" aria-pressed="false">
              <Icon name="play" class="icon-play" />
              <Icon name="pause" class="icon-pause" />
              <span data-label>{t(lang, 'sim.play')}</span>
            </button>
            <button class="btn btn--icon" type="button" data-action="reset-time" title={t(lang, 'sim.resetTime')} aria-label={t(lang, 'sim.resetTime')}>
              <Icon name="skip-back" />
            </button>
          </div>
          <button class="btn" type="button" data-action="reset" title={t(lang, 'sim.resetHint')}>
            <Icon name="reset" />
            <span data-label>{t(lang, 'sim.reset')}</span>
          </button>
        </div>
        <div class="sim__toolbar-group">
          <button class="btn" type="button" data-action="share">
            <Icon name="share" />
            <span data-label>{t(lang, 'sim.share')}</span>
          </button>
          <button class="btn btn--icon" type="button" data-action="image" title={t(lang, 'sim.image')} aria-label={t(lang, 'sim.image')}>
            <Icon name="download" />
          </button>
          <button class="btn btn--icon" type="button" data-action="fullscreen" title={t(lang, 'sim.fullscreen')} aria-label={t(lang, 'sim.fullscreen')} aria-pressed="false">
            <Icon name="fullscreen" />
          </button>
        </div>
      </div>
      <p class="sim__hint" data-sim-hint hidden>{t(lang, 'sim.dragHint')}</p>
    </div>

    <div class="sim__panel" role="region" aria-label={t(lang, 'sim.panel')}>
      <div class="sim__lock" data-sim-lock hidden>
        <span>{t(lang, 'sim.locked')}</span>
        <button class="btn" type="button" data-action="unlock"><Icon name="lock" size={16} />{t(lang, 'sim.unlock')}</button>
      </div>
      <!-- Reiter: Einstellungen · Beispiele · Ergebnisse (Umschalten in sim-core/host.ts, bindTabs) -->
      <div class="sim-tabs" role="tablist" aria-label={t(lang, 'sim.panel')} data-sim-tabs>
        <button class="sim-tabs__tab" type="button" role="tab" id={`${simId}-tab-controls`} aria-controls={`${simId}-panel-controls`} aria-selected="true" data-sim-tab="controls">
          {t(lang, 'sim.controls')}
        </button>
        <button class="sim-tabs__tab" type="button" role="tab" id={`${simId}-tab-presets`} aria-controls={`${simId}-panel-presets`} aria-selected="false" tabindex="-1" data-sim-tab="presets" hidden>
          {t(lang, 'sim.presets')} <span class="sim-tabs__count" data-sim-preset-count></span>
        </button>
        <button class="sim-tabs__tab" type="button" role="tab" id={`${simId}-tab-readouts`} aria-controls={`${simId}-panel-readouts`} aria-selected="false" tabindex="-1" data-sim-tab="readouts" hidden>
          {t(lang, 'sim.readouts')}
        </button>
      </div>
      <div class="sim-tabpanel" role="tabpanel" id={`${simId}-panel-controls`} aria-labelledby={`${simId}-tab-controls`} data-sim-tabpanel="controls">
        <div data-sim-controls></div>
      </div>
      <div class="sim-tabpanel" role="tabpanel" id={`${simId}-panel-presets`} aria-labelledby={`${simId}-tab-presets`} data-sim-tabpanel="presets" hidden>
        <div class="preset-list" data-sim-preset-list></div>
        <button class="preset-list__more" type="button" data-sim-presets-more hidden></button>
      </div>
      <div class="sim-tabpanel" role="tabpanel" id={`${simId}-panel-readouts`} aria-labelledby={`${simId}-tab-readouts`} data-sim-tabpanel="readouts" hidden>
        <dl class="readouts" data-sim-readouts aria-live="off"></dl>
      </div>
    </div>
  </div>

  <dialog class="share-dialog" data-sim-share aria-labelledby={dialogTitleId}>
    <form method="dialog" class="share">
      <div class="share__head">
        <h2 id={dialogTitleId}>{t(lang, 'share.title')}</h2>
        <button class="btn btn--ghost btn--icon" value="close" aria-label={t(lang, 'share.close')}><Icon name="close" /></button>
      </div>
      <p class="share__intro">{t(lang, 'share.intro')}</p>
      <div class="share__options">
        <label class="switch share__option">
          <input class="switch__input" type="checkbox" role="switch" data-share-lock />
          <span class="switch__track" aria-hidden="true"></span>
          <span class="switch__label">{t(lang, 'share.lock')}</span>
        </label>
        <label class="switch share__option">
          <input class="switch__input" type="checkbox" role="switch" data-share-hide />
          <span class="switch__track" aria-hidden="true"></span>
          <span class="switch__label">{t(lang, 'share.hide')}</span>
        </label>
      </div>
      <div class="share__link">
        <input class="input" type="text" readonly data-share-url aria-label={t(lang, 'share.link')} />
        <button class="btn btn--primary" type="button" data-share-copy><Icon name="copy" size={18} /><span data-label>{t(lang, 'share.copy')}</span></button>
      </div>
      <div class="share__qr">
        <div class="share__qr-code" data-share-qr></div>
        <div>
          <p class="muted" style="margin:0 0 10px;font-size:.9rem">{t(lang, 'share.qr')}</p>
          <button class="btn" type="button" data-share-qr-large><Icon name="qr" size={18} />{t(lang, 'share.qrLarge')}</button>
        </div>
      </div>
    </form>
  </dialog>

  <div class="qr-overlay" data-qr-overlay hidden tabindex="-1" role="dialog" aria-label={t(lang, 'share.qr')}>
    <div class="qr-overlay__code" data-qr-large></div>
    <div class="qr-overlay__url" data-qr-url></div>
  </div>
</section>

<script>
  import { mountSimulation } from '../sim-core/host';

  for (const root of document.querySelectorAll<HTMLElement>('[data-sim-root]')) {
    void mountSimulation(root);
  }
</script>
