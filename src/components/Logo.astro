---
/**
 * Scitura-Logo 01 in dunklem Marineblau (#183365), Rasterbild mit transparentem
 * Hintergrund. Herkunft und Masterdatei: docs/design/coin-reise-v13/LOGO-HERKUNFT.md.
 * Im dunklen Farbschema wird das Zeichen per CSS hell dargestellt (global.css, .brand__logo).
 */
import logo from '../assets/brand/scitura-logo.png';

interface Props {
  class?: string;
  /** Anzeigegröße in Pixeln (quadratisch). */
  size?: number;
}
const { class: className, size = 44 } = Astro.props;
---

<img class={className} src={logo.src} width={size} height={size} alt="" decoding="async" />
