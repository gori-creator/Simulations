---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="logo-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3b6ff0" />
      <stop offset="1" stop-color="#1f45a8" />
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="15" fill="url(#logo-bg)" />
  <path d="M8 40h48M14 14v38" stroke="#ffffff" stroke-opacity=".35" stroke-width="2.5" stroke-linecap="round" />
  <path d="M10 40c6 0 8-22 14-22s8 22 14 22 8-12 14-12" fill="none" stroke="#ffffff" stroke-width="4.5" stroke-linecap="round" />
  <circle cx="24" cy="18" r="5.5" fill="#ffb347" stroke="#ffffff" stroke-width="2" />
</svg>
