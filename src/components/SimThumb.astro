---
import type { Thumb } from '../curriculum/types';

/**
 * Schlichte Vorschaubilder für Simulationskarten (Farbe über currentColor).
 */
interface Props {
  kind?: Thumb;
}

const { kind = 'generic' } = Astro.props;
/** Vorschaubilder mit Koordinatenachsen (Funktionen); die übrigen zeigen nur das Gitter. */
const withAxes = ['line', 'parabola', 'sine', 'unit-circle', 'secant', 'growth', 'riemann', 'generic'].includes(kind);
---

<svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <g stroke="currentColor" stroke-opacity="0.12" stroke-width="1">
    {Array.from({ length: 17 }, (_, i) => <line x1={i * 20} y1="0" x2={i * 20} y2="180" />)}
    {Array.from({ length: 10 }, (_, i) => <line x1="0" y1={i * 20} x2="320" y2={i * 20} />)}
  </g>
  {
    withAxes && (
      <g stroke="currentColor" stroke-opacity="0.45" stroke-width="2">
        <line x1="0" y1="100" x2="320" y2="100" />
        <line x1="140" y1="0" x2="140" y2="180" />
      </g>
    )
  }
  {
    kind === 'line' && (
      <g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round">
        <line x1="20" y1="160" x2="300" y2="20" />
        <path d="M140 100h40v-20" stroke-width="3" stroke-opacity="0.6" />
        <circle cx="140" cy="100" r="7" fill="currentColor" stroke="none" />
      </g>
    )
  }
  {
    kind === 'parabola' && (
      <g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round">
        <path d="M70 0Q160 260 250 0" />
        <line x1="160" y1="0" x2="160" y2="180" stroke-width="2" stroke-dasharray="6 6" stroke-opacity="0.6" />
        <circle cx="160" cy="130" r="7" fill="currentColor" stroke="none" />
      </g>
    )
  }
  {
    kind === 'sine' && (
      <g fill="none" stroke="currentColor" stroke-linecap="round">
        <path d="M0 100C30 100 40 45 70 45S110 155 140 155 180 45 210 45 250 155 280 155 310 100 320 100" stroke-width="5" />
        <path d="M0 100C30 100 40 70 70 70S110 130 140 130 180 70 210 70 250 130 280 130" stroke-width="2.5" stroke-opacity="0.4" stroke-dasharray="6 6" />
      </g>
    )
  }
  {
    kind === 'unit-circle' && (
      <g fill="none" stroke="currentColor" stroke-linecap="round">
        <circle cx="140" cy="100" r="62" stroke-width="3" stroke-opacity="0.6" />
        <line x1="140" y1="100" x2="194" y2="69" stroke-width="4" />
        <line x1="194" y1="100" x2="194" y2="69" stroke-width="5" />
        <path d="M168 100A28 28 0 0 0 164 86" stroke-width="3" />
        <circle cx="194" cy="69" r="7" fill="currentColor" stroke="none" />
        <path d="M210 69C230 69 240 40 255 40S285 100 300 100" stroke-width="3" stroke-opacity="0.7" stroke-dasharray="6 6" />
      </g>
    )
  }
  {
    kind === 'thales' && (
      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M70 140A90 90 0 0 1 250 140" stroke-width="3" stroke-opacity="0.55" />
        <line x1="60" y1="140" x2="260" y2="140" stroke-width="3" stroke-opacity="0.55" />
        <path d="M70 140L196 68L250 140" stroke-width="5" />
        <path d="M184 75l7 12l12-7" stroke-width="3" />
        <circle cx="196" cy="68" r="7" fill="currentColor" stroke="none" />
        <circle cx="70" cy="140" r="5" fill="currentColor" stroke="none" />
        <circle cx="250" cy="140" r="5" fill="currentColor" stroke="none" />
      </g>
    )
  }
  {
    kind === 'binomial' && (
      <g stroke="currentColor" stroke-width="3">
        <rect x="90" y="20" width="96" height="96" fill="currentColor" fill-opacity="0.35" />
        <rect x="186" y="20" width="44" height="96" fill="currentColor" fill-opacity="0.15" />
        <rect x="90" y="116" width="96" height="44" fill="currentColor" fill-opacity="0.15" />
        <rect x="186" y="116" width="44" height="44" fill="currentColor" fill-opacity="0.55" />
      </g>
    )
  }
  {
    kind === 'pythagoras' && (
      <g stroke="currentColor" stroke-width="3" stroke-linejoin="round">
        <path d="M130 110L190 110L130 65Z" fill="currentColor" fill-opacity="0.55" />
        <path d="M130 110L190 110L190 170L130 170Z" fill="currentColor" fill-opacity="0.18" />
        <path d="M130 110L130 65L85 65L85 110Z" fill="currentColor" fill-opacity="0.18" />
        <path d="M130 65L190 110L235 50L175 5Z" fill="currentColor" fill-opacity="0.3" />
      </g>
    )
  }
  {
    kind === 'frequency' && (
      <g fill="none" stroke="currentColor" stroke-linecap="round">
        <path d="M20 90C40 30 60 150 80 70S120 120 150 92S220 102 300 96" stroke-width="5" />
        <path d="M20 40Q100 88 300 92M20 150Q100 104 300 100" stroke-width="2" stroke-opacity="0.45" />
        <line x1="20" y1="96" x2="300" y2="96" stroke-width="2.5" stroke-dasharray="7 6" stroke-opacity="0.7" />
      </g>
    )
  }
  {
    kind === 'doors' && (
      <g stroke="currentColor" stroke-width="3">
        <rect x="40" y="40" width="64" height="112" rx="4" fill="currentColor" fill-opacity="0.35" />
        <path d="M128 40h64v112h-64z" fill="currentColor" fill-opacity="0.08" />
        <path d="M128 40l22 8v96l-22 8z" fill="currentColor" fill-opacity="0.45" />
        <rect x="216" y="40" width="64" height="112" rx="4" fill="currentColor" fill-opacity="0.35" />
        <circle cx="94" cy="100" r="4" fill="currentColor" stroke="none" />
        <circle cx="270" cy="100" r="4" fill="currentColor" stroke="none" />
        <text x="160" y="110" font-size="34" text-anchor="middle" fill="currentColor" stroke="none" font-weight="700">?</text>
      </g>
    )
  }
  {
    kind === 'monte-carlo' && (
      <g>
        <rect x="90" y="20" width="140" height="140" fill="none" stroke="currentColor" stroke-width="3" />
        <path d="M90 20A140 140 0 0 1 230 160" fill="none" stroke="currentColor" stroke-width="4" />
        {Array.from({ length: 70 }, (_, i) => {
          const x = ((i * 37) % 97) / 97;
          const y = ((i * 61) % 89) / 89;
          const inside = x * x + y * y <= 1;
          return <circle cx={90 + x * 140} cy={160 - y * 140} r="3.2" fill="currentColor" fill-opacity={inside ? 0.85 : 0.3} />;
        })}
      </g>
    )
  }
  {
    kind === 'secant' && (
      <g fill="none" stroke="currentColor" stroke-linecap="round">
        <path d="M60 10Q140 190 240 10" stroke-width="5" />
        <line x1="40" y1="170" x2="290" y2="20" stroke-width="3" stroke-opacity="0.75" />
        <line x1="40" y1="138" x2="290" y2="102" stroke-width="2.5" stroke-dasharray="7 6" stroke-opacity="0.6" />
        <circle cx="168" cy="118" r="7" fill="currentColor" stroke="none" />
        <circle cx="212" cy="60" r="7" fill="currentColor" stroke="none" />
      </g>
    )
  }
  {
    kind === 'galton' && (
      <g fill="currentColor">
        {Array.from({ length: 6 }, (_, row) =>
          Array.from({ length: row + 1 }, (_, j) => <circle cx={160 + (j - row / 2) * 26} cy={22 + row * 18} r="3.5" fill-opacity="0.6" />),
        )}
        {[1, 6, 15, 20, 15, 6, 1].map((c, k) => (
          <rect x={160 + (k - 3) * 26 - 10} y={172 - c * 3} width="20" height={c * 3} fill-opacity="0.75" />
        ))}
      </g>
    )
  }
  {
    kind === 'fraction' && (
      <g stroke="currentColor" stroke-width="3" stroke-linejoin="round">
        <circle cx="120" cy="92" r="62" fill="currentColor" fill-opacity="0.12" />
        <path d="M120 92V30A62 62 0 0 1 182 92Z" fill="currentColor" fill-opacity="0.55" transform="translate(8 -8)" />
        <path d="M120 92H182A62 62 0 0 1 120 154Z" fill="currentColor" fill-opacity="0.55" transform="translate(8 8)" />
        <path d="M120 92V154A62 62 0 0 1 58 92Z" fill="currentColor" fill-opacity="0.55" transform="translate(-8 8)" />
        <line x1="236" y1="92" x2="284" y2="92" stroke-width="4" />
        <text x="260" y="78" font-size="34" text-anchor="middle" fill="currentColor" stroke="none" font-weight="800">3</text>
        <text x="260" y="126" font-size="34" text-anchor="middle" fill="currentColor" stroke="none" font-weight="800">4</text>
      </g>
    )
  }
  {
    kind === 'circle-pi' && (
      <g fill="none" stroke="currentColor" stroke-linecap="round">
        <line x1="20" y1="150" x2="300" y2="150" stroke-width="3" stroke-opacity="0.6" />
        <line x1="40" y1="150" x2="180" y2="150" stroke-width="7" />
        <circle cx="222" cy="106" r="44" stroke-width="4" />
        <path d="M222 106l31 -31M222 106l-31 31M222 106l31 31M222 106l-31 -31" stroke-width="2" stroke-opacity="0.6" />
        <path d="M40 166h44M86 166h44M132 166h44" stroke-width="5" stroke-opacity="0.45" />
        <text x="110" y="120" font-size="40" text-anchor="middle" fill="currentColor" stroke="none" font-weight="700" font-style="italic">π</text>
      </g>
    )
  }
  {
    kind === 'growth' && (
      <g fill="none" stroke="currentColor" stroke-linecap="round">
        <path d="M140 98C190 97 230 92 260 70S292 22 300 0" stroke-width="5" />
        <path d="M140 98L300 60" stroke-width="3" stroke-opacity="0.45" stroke-dasharray="7 6" />
        {[160, 190, 220, 250, 280].map((x, i) => <circle cx={x} cy={[97, 95, 90, 74, 40][i]} r="5" fill="currentColor" stroke="none" />)}
      </g>
    )
  }
  {
    kind === 'riemann' && (
      <g stroke="currentColor" stroke-width="2">
        {[0, 1, 2, 3, 4, 5].map((i) => {
          const x = 150 + i * 24;
          const h = 6 + ((i + 1) * (i + 1) * 2.2);
          return <rect x={x} y={100 - h} width="24" height={h} fill="currentColor" fill-opacity="0.3" />;
        })}
        <path d="M140 100Q220 100 300 8" fill="none" stroke-width="5" />
      </g>
    )
  }
  {
    kind === 'projectile' && (
      <g fill="none" stroke="currentColor" stroke-linecap="round">
        <line x1="10" y1="160" x2="310" y2="160" stroke-width="4" stroke-opacity="0.6" />
        <path d="M30 160Q150 -20 280 160" stroke-width="4" stroke-dasharray="2 10" />
        <path d="M30 160L70 112" stroke-width="5" />
        <path d="M60 112h10v10" stroke-width="5" stroke-linejoin="round" />
        {[0.15, 0.3, 0.45, 0.6, 0.75].map((u) => {
          const x = 30 + 250 * u;
          const y = 160 - 4 * 90 * u * (1 - u);
          return <circle cx={x} cy={y} r="5" fill="currentColor" stroke="none" fill-opacity="0.5" />;
        })}
        <circle cx="205" cy="70" r="11" fill="currentColor" stroke="none" />
      </g>
    )
  }
  {
    kind === 'pendulum' && (
      <g fill="none" stroke="currentColor" stroke-linecap="round">
        <line x1="100" y1="16" x2="220" y2="16" stroke-width="6" />
        <line x1="160" y1="16" x2="214" y2="132" stroke-width="3" />
        <line x1="160" y1="16" x2="160" y2="150" stroke-width="2" stroke-dasharray="5 5" stroke-opacity="0.5" />
        <path d="M110 136A128 128 0 0 0 210 136" stroke-width="2" stroke-dasharray="4 6" stroke-opacity="0.6" />
        <path d="M160 56A40 40 0 0 0 177 52" stroke-width="3" />
        <circle cx="214" cy="132" r="18" fill="currentColor" stroke="none" />
      </g>
    )
  }
  {
    kind === 'coaster' && (
      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 30C60 30 70 160 120 160C150 160 150 110 175 110C200 110 200 160 230 160C270 160 280 60 310 60" stroke-width="5" />
        {[40, 70, 100, 130, 170, 210, 250, 280].map((x) => <line x1={x} y1="175" x2={x} y2={x < 60 ? 60 : x > 260 ? 100 : 162} stroke-width="2" stroke-opacity="0.4" />)}
        <rect x="58" y="80" width="30" height="16" rx="4" fill="currentColor" stroke="none" transform="rotate(62 73 88)" />
      </g>
    )
  }
  {
    kind === 'refraction' && (
      <g fill="none" stroke="currentColor" stroke-linecap="round">
        <rect x="0" y="95" width="320" height="85" fill="currentColor" fill-opacity="0.15" stroke="none" />
        <line x1="0" y1="95" x2="320" y2="95" stroke-width="3" />
        <line x1="160" y1="10" x2="160" y2="175" stroke-width="2" stroke-dasharray="6 6" stroke-opacity="0.6" />
        <path d="M80 15L160 95L208 175" stroke-width="5" />
        <path d="M160 95L240 15" stroke-width="3" stroke-opacity="0.35" />
      </g>
    )
  }
  {
    kind === 'generic' && (
      <g fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-opacity="0.55">
        <path d="M20 150C80 150 100 50 160 50s80 70 140 70" />
        <circle cx="160" cy="50" r="7" fill="currentColor" stroke="none" />
      </g>
    )
  }
</svg>
