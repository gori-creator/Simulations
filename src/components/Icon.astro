---
/**
 * Einfache Strich-Icons (24×24) als Inline-SVG – ohne externe Icon-Bibliothek.
 */
const ICONS = {
  play: { fill: 'M8 5.5v13a1 1 0 0 0 1.5.86l10-6.5a1 1 0 0 0 0-1.72l-10-6.5A1 1 0 0 0 8 5.5z' },
  pause: { fill: 'M7 5h3.5v14H7zM13.5 5H17v14h-3.5z' },
  'skip-back': { stroke: 'M19 20 9 12l10-8v16zM5 19V5' },
  reset: { stroke: 'M3 12a9 9 0 1 0 3-6.7M3 4v5h5' },
  share: { stroke: 'M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM8.6 13.5l6.8 4M15.4 6.5l-6.8 4' },
  fullscreen: { stroke: 'M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3' },
  download: { stroke: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3' },
  sun: { stroke: 'M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4' },
  moon: { stroke: 'M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z' },
  menu: { stroke: 'M4 6h16M4 12h16M4 18h16' },
  close: { stroke: 'M6 6l12 12M18 6 6 18' },
  arrow: { stroke: 'M5 12h14M13 6l6 6-6 6' },
  lock: { stroke: 'M6 11h12v10H6zM8 11V7a4 4 0 0 1 8 0v4' },
  copy: { stroke: 'M9 9h11v11H9zM5 15H4V4h11v1' },
  qr: { stroke: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h3v3h-3zM20 14v.01M14 20h.01M17 20h4v-3' },
  shield: { stroke: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4' },
  offline: { stroke: 'M12 20h.01M8.5 16.4a5 5 0 0 1 7 0M5 12.9a10 10 0 0 1 14 0M1.5 9.4a15 15 0 0 1 21 0' },
  devices: { stroke: 'M3 5h14v10H3zM7 19h6M10 15v4M17 9h4v11h-4z' },
  heart: { stroke: 'M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z' },
  code: { stroke: 'M16 18l6-6-6-6M8 6l-6 6 6 6' },
  function: { stroke: 'M4 3v17h17M7 16c2-7 4-10 6-10s3 4 6 10' },
  atom: { stroke: 'M12 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM20.2 20.2c2-2-.4-7.6-5.4-12.6S3.8 1.8 1.8 3.8s.4 7.6 5.4 12.6 11 7.8 13 5.8zM15.6 15.6c5-5 7.4-10.6 5.4-12.6S11.4 1.6 6.4 6.6s-7.4 10.6-5.4 12.6 7.6.4 12.6-4.4' },
  flask: { stroke: 'M9 3h6M10 3v6L4.5 19A1.5 1.5 0 0 0 5.8 21h12.4a1.5 1.5 0 0 0 1.3-2L14 9V3M7 15h10' },
  search: { stroke: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-5-5' },
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const icon = ICONS[name];
const fill = 'fill' in icon ? icon.fill : undefined;
const stroke = 'stroke' in icon ? icon.stroke : undefined;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  {fill && <path d={fill} fill="currentColor" />}
  {
    stroke && (
      <path d={stroke} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    )
  }
</svg>
