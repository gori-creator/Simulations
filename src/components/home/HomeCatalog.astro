---
/**
 * Startseite: alle fertigen Simulationen aus dem aktuellen Lehrplan, mit den
 * normalen Simulationskarten (Vorschaubilder, Klassenstufen, Bundesland-Etiketten
 * und -Sortierung).
 *
 * Zwei Ansichten (Umschalten in src/lib/home/catalog.ts):
 * - Themenreihen (Grundansicht): je Bereich eine seitlich wischbare Reihe mit
 *   Bereichssymbol und Link zur Bereichsseite, darüber eine Themenleiste, die
 *   beim Scrollen mitläuft und den aktuellen Bereich zeigt. Die Fachknöpfe
 *   blenden die Reihen der anderen Fächer aus.
 * - Raster: sobald gesucht oder nach Klassenstufe gefiltert wird, die Treffer.
 */
import AreaGlyph from '../AreaGlyph.astro';
import { GRADE_BANDS, readySimulations, simulationsOf, SUBJECTS } from '../../curriculum';
import { byShowcase, showcaseRank } from '../../lib/home/showcase';
import type { Lang } from '../../i18n/config';
import { t } from '../../i18n/utils';
import { href } from '../../lib/routes';
import SimCard from '../SimCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sims = readySimulations();
const countOf = (subject: string) => simulationsOf({ subject: subject as (typeof SUBJECTS)[number]['id'] }).filter((s) => s.status === 'ready').length;

// Themenreihen: jeder Bereich mit fertigen Simulationen. Reihen und Karten so geordnet,
// dass die eindrucksvollsten Simulationen (lib/home/showcase.ts) vorn stehen; sonst
// Reihenfolge des Lehrplans.
const rows = SUBJECTS.flatMap((subject) =>
  subject.areas
    .map((area) => ({ subject, area, sims: byShowcase(sims.filter((s) => s.subject === subject.id && s.area === area.id)) }))
    .filter((row) => row.sims.length > 0),
)
  .map((row, i) => ({ row, i, r: Math.min(...row.sims.map((s) => showcaseRank(s.id))) }))
  .sort((a, b) => (a.r === b.r ? a.i - b.i : a.r - b.r))
  .map((x) => x.row);
const rowId = (subject: string, area: string) => `reihe-${subject}-${area}`;
---

<section class="home-catalog" id="simulations" aria-labelledby="catalog-title" data-home-catalog>
  <h2 id="catalog-title">{t(lang, 'home.featured')}</h2>
  <div class="home-catalog__bar">
    <div class="home-catalog__subjects" role="group" aria-label={t(lang, 'home.filterSubject')}>
      <button type="button" data-filter="all" aria-pressed="true">
        <span>{t(lang, 'home.filterAll')}</span><small>{sims.length}</small>
      </button>
      {
        SUBJECTS.map((subject) => {
          const n = countOf(subject.id);
          return (
            <button type="button" data-filter={subject.id} aria-pressed="false">
              <span>{subject.title[lang]}</span>
              <small>{subject.status === 'active' && n > 0 ? n : t(lang, 'nav.soon')}</small>
            </button>
          );
        })
      }
    </div>
    <div class="home-catalog__search">
      <label class="home-catalog__searchbox">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="6"></circle><path d="m15 15 5 5"></path></svg>
        <input type="search" data-catalog-search placeholder={t(lang, 'home.searchPlaceholder')} aria-label={t(lang, 'home.searchLabel')} autocomplete="off" />
      </label>
      <label class="visually-hidden" for="home-grade">{t(lang, 'catalog.grade')}</label>
      <select id="home-grade" data-catalog-grade>
        <option value="">{t(lang, 'grades.all')}</option>
        {GRADE_BANDS.map((b) => <option value={`${b.span[0]}-${b.span[1]}`}>{t(lang, `grades.band.${b.id}`)}</option>)}
      </select>
    </div>
  </div>
  <p class="home-catalog__count" data-catalog-count data-template={t(lang, 'home.results', { n: '{n}', total: '{total}' })} aria-live="polite">
    {t(lang, 'home.results', { n: sims.length, total: sims.length })}
  </p>
  <nav class="home-topics" aria-label={t(lang, 'home.topics')} data-catalog-topics>
    <div class="home-topics__track" data-topics-track>
      {
        rows.map(({ subject, area }) => (
          <a class={`home-topics__chip subject-${subject.id}`} href={`#${rowId(subject.id, area.id)}`} data-topic={rowId(subject.id, area.id)} data-subject={subject.id}>
            <span class="home-topics__dot" aria-hidden="true" />
            {area.title[lang]}
          </a>
        ))
      }
    </div>
  </nav>
  <div class="home-rows" data-catalog-rows>
    {
      rows.map(({ subject, area, sims: list }) => (
        <section class={`home-row subject-${subject.id}`} id={rowId(subject.id, area.id)} data-row data-subject={subject.id} aria-labelledby={`${rowId(subject.id, area.id)}-title`}>
          <header class="home-row__head">
            <span class="home-row__glyph">
              <AreaGlyph area={area.id} size={34} />
            </span>
            <div class="home-row__titles">
              <span class="home-row__kicker">{subject.title[lang]}</span>
              <h3 id={`${rowId(subject.id, area.id)}-title`}>{area.title[lang]}</h3>
            </div>
            <span class="home-row__count">{t(lang, 'home.rowCount', { n: list.length })}</span>
            <a class="home-row__all" href={href(lang, { kind: 'area', subject: subject.id, area: area.id })}>
              {t(lang, 'home.rowAll')}
              <span aria-hidden="true">→</span>
            </a>
            <span class="home-row__nav">
              <button type="button" class="home-row__btn" data-row-prev aria-label={t(lang, 'home.rowPrev')}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" /></svg>
              </button>
              <button type="button" class="home-row__btn" data-row-next aria-label={t(lang, 'home.rowNext')}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
              </button>
            </span>
          </header>
          <div class="home-row__track" data-row-track data-region-sort>
            {list.map((sim) => <SimCard lang={lang} sim={sim} showSubject />)}
          </div>
        </section>
      ))
    }
  </div>
  {/* Trefferraster: leer ausgeliefert, das Skript füllt es beim ersten Suchen mit Kopien der Reihen-Karten (spart rund 130 Karten im HTML) */}
  <div class="card-grid home-catalog__grid" data-catalog-grid data-region-sort hidden></div>
  <div
    class="home-catalog__empty"
    data-catalog-empty
    data-title={t(lang, 'home.emptyTitle')}
    data-text={t(lang, 'home.emptyText')}
    data-chem-title={t(lang, 'home.chemTitle')}
    data-chem-text={t(lang, 'home.chemText')}
    hidden
  >
    <span aria-hidden="true">∅</span>
    <h3 data-empty-title>{t(lang, 'home.emptyTitle')}</h3>
    <p data-empty-text>{t(lang, 'home.emptyText')}</p>
    <button type="button" class="btn btn--primary" data-catalog-clear>{t(lang, 'home.clear')}</button>
  </div>
</section>
