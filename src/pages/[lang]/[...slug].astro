---
/**
 * Alle Unterseiten (außer der Startseite) werden hier aus dem Lehrplan und
 * der Routen-Tabelle (src/lib/routes.ts) erzeugt – in beiden Sprachen.
 */
import { LANGS, type Lang } from '../../i18n/config';
import { allRoutes, routeSegments, type Route } from '../../lib/routes';
import AreaView from '../../views/AreaView.astro';
import CatalogView from '../../views/CatalogView.astro';
import InfoPageView from '../../views/InfoPageView.astro';
import SimulationView from '../../views/SimulationView.astro';
import SubjectView from '../../views/SubjectView.astro';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    allRoutes().map((route) => ({
      params: { lang, slug: routeSegments(lang, route).join('/') },
      props: { route },
    })),
  );
}

const lang = Astro.params.lang as Lang;
const { route } = Astro.props as { route: Route };
---

{route.kind === 'catalog' && <CatalogView lang={lang} />}
{route.kind === 'page' && <InfoPageView lang={lang} page={route.page} />}
{route.kind === 'subject' && <SubjectView lang={lang} subjectId={route.subject} />}
{route.kind === 'area' && <AreaView lang={lang} subjectId={route.subject} areaId={route.area} />}
{route.kind === 'simulation' && <SimulationView lang={lang} simId={route.id} />}
