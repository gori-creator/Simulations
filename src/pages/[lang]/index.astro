---
/**
 * Startseite (Scitura): heller Einstieg mit Skulptur, Münzbahn, Achterbahn mit
 * der echten Energieerhaltung und vollständiger Simulationskatalog.
 * Entwurf und Abnahme: docs/design/coin-reise-v13/ (START-HIER.md, ABNAHME.md).
 */
import HomeCatalog from '../../components/home/HomeCatalog.astro';
import HomeExperiment from '../../components/home/HomeExperiment.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import { LANGS, type Lang } from '../../i18n/config';
import BaseLayout from '../../layouts/BaseLayout.astro';
// Nach dem Layout (global.css) laden, damit die Startseiten-Regeln Vorrang haben.
import '../../styles/home.css';
import { alternates } from '../../lib/routes';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<BaseLayout lang={lang} alternates={alternates({ kind: 'home' })} motionToggle>
  <div class="scitura-home" data-scitura-home>
    <HomeHero lang={lang} />
    <HomeExperiment lang={lang} />
    <HomeCatalog lang={lang} />
  </div>
</BaseLayout>

<script>
  import type { Lang } from '../../i18n/config';
  import { initCatalog } from '../../lib/home/catalog';
  import { initEnergyStage } from '../../lib/home/energy-stage';
  import { bindMotionToggle } from '../../lib/home/motion';
  import { initSculpture, type Journey } from '../../lib/home/sculpture';

  const home = document.querySelector<HTMLElement>('[data-scitura-home]');
  const teardown: (() => void)[] = [];

  if (home) {
    const lang = (document.documentElement.lang === 'en' ? 'en' : 'de') satisfies Lang;
    const toggle = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
    if (toggle) teardown.push(bindMotionToggle(toggle));

    const q = <T extends Element>(selector: string) => home.querySelector<T>(selector)!;
    let journey: Journey | null = null;
    try {
      journey = initSculpture({
        root: home,
        hero: q('[data-home-hero]'),
        wrap: q('[data-sculpture]'),
        canvas: q('[data-sculpture-canvas]'),
        guide: q('[data-coin-guide]'),
        path: q('[data-journey-path]'),
        anchor: q('[data-coin]'),
        rotor: q('[data-coin-rotor]'),
        dock: q('[data-coin-dock]'),
        experiment: q('[data-home-experiment]'),
        footer: document.querySelector('.site-footer'),
      });
      teardown.push(() => journey?.destroy());
    } catch (error) {
      // Ohne Bewegung bleibt die Seite vollständig bedienbar (Ersatzgrafik).
      console.warn('Startseite: Skulptur nicht verfügbar:', error);
    }
    // Lichtkegel und Sterne des Einstiegs nur animieren, solange er zu sehen ist (spart Rechenzeit beim Scrollen und während der Achterbahnfahrt)
    const hero = q<HTMLElement>('[data-home-hero]');
    const heroObserver = new IntersectionObserver(([entry]) => hero.classList.toggle('is-offscreen', !entry?.isIntersecting));
    heroObserver.observe(hero);
    teardown.push(() => heroObserver.disconnect());
    teardown.push(initEnergyStage({ root: q('[data-home-experiment]'), lang, journey }));
    teardown.push(initCatalog(q('[data-home-catalog]')));

    // Abbau beim endgültigen Verlassen (nicht beim Zwischenspeichern im Verlauf)
    addEventListener('pagehide', (event) => {
      if (event.persisted) return;
      for (const stop of teardown.splice(0)) stop();
    });
  }
</script>
