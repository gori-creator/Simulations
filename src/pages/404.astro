---
/**
 * Fehlerseite (404). Der Server liefert sie für jede unbekannte Adresse aus,
 * die Sprache ist also unbekannt: deutsch mit englischer Zeile, Kopf- und
 * Fußzeile wie überall, Suche und ein paar Simulationen zum Weitermachen.
 */
import SimCard from '../components/SimCard.astro';
import { allSimulations } from '../curriculum';
import BaseLayout from '../layouts/BaseLayout.astro';
import { href, withBase } from '../lib/routes';

// Bekannte Einstiege aus beiden Fächern (nur fertige)
const PICKS = ['pythagoras', 'quadratische-funktion', 'schiefe-ebene', 'fadenpendel'];
const picks = allSimulations().filter((s) => PICKS.includes(s.id) && s.status === 'ready');
---

<BaseLayout lang="de" title="Seite nicht gefunden" alternates={{ de: '/de/', en: '/en/' }} noindex>
  <div class="container not-found">
    <header class="page-head">
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1>Seite nicht gefunden</h1>
      <p class="lead">
        Diese Seite gibt es leider nicht (mehr). Vielleicht hilft die Suche weiter.
      </p>
      <p class="muted" lang="en">Page not found – this page does not exist (anymore).</p>
    </header>

    <form class="not-found__search" action={href('de', { kind: 'catalog' })} method="get" role="search">
      <label class="visually-hidden" for="nf-q">Simulation suchen</label>
      <input class="input" id="nf-q" type="search" name="q" placeholder="z. B. Parabel, Pendel, Bruch" autocomplete="off" />
      <button class="btn btn--primary" type="submit">Suchen</button>
    </form>

    <p class="not-found__links">
      <a class="btn" href={withBase('/de/')}>Zur Startseite</a>
      <a class="btn" href={href('de', { kind: 'catalog' })}>Alle Simulationen</a>
      <a class="btn btn--ghost" href={withBase('/en/')} lang="en">Home page (English)</a>
    </p>

    {
      picks.length > 0 && (
        <section class="section" style="padding-top:24px" aria-labelledby="nf-picks">
          <h2 id="nf-picks" class="band-heading">Beliebte Simulationen</h2>
          <div class="card-grid">
            {picks.map((sim) => (
              <SimCard lang="de" sim={sim} showSubject />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
