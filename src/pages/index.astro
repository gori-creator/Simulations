---
/**
 * Einstieg ohne Sprache: leitet zur gemerkten bzw. Browsersprache weiter
 * (Standard: Deutsch).
 */
import { SITE } from '../config/site';
import { cspHash } from '../lib/csp';
import { withBase } from '../lib/routes';

const de = withBase('/de/');
const en = withBase('/en/');
// Sprache wählen und weiterleiten; als fertige Zeichenkette, damit die Prüfsumme der Content-Security-Policy passt.
const redirectScript = `let l=null;try{l=localStorage.getItem('lang')}catch{}if(l!=='de'&&l!=='en'){l=(navigator.languages||[navigator.language]).some((x)=>String(x).toLowerCase().startsWith('de'))?'de':'en'}location.replace(l==='en'?${JSON.stringify(en)}:${JSON.stringify(de)});`;
Astro.csp?.insertScriptHash(cspHash(redirectScript));
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.name.de}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" sizes="64x64" />
    <link rel="alternate" hreflang="de" href={de} />
    <link rel="alternate" hreflang="en" href={en} />
    <noscript><meta http-equiv="refresh" content={`0; url=${de}`} /></noscript>
    <script is:inline set:html={redirectScript} />
  </head>
  <body>
    <p><a href={de}>Deutsch</a> · <a href={en}>English</a></p>
  </body>
</html>
