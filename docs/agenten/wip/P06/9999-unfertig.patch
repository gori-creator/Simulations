+      tick(yB, withAlpha(theme.text, 0.5));
+      g.strokeStyle = s0c;
+      g.lineWidth = 2;
+      g.beginPath();
+      g.moveTo(x, yB);
+      g.lineTo(x, yC);
+      g.stroke();
