@@ -0,0 +1,134 @@
+/**
+ * Rechenlogik „Erzwungene Schwingung und Resonanz“ am Pohlschen Rad.
+ *
+ * Ein Drehpendel (Rad mit Spiralfeder) wird über einen Motor mit Exzenter
+ * angetrieben: Das äußere Ende der Spiralfeder (Erregerhebel) schwingt mit
+ * φ_E(t) = φ̂_E · sin(ω_E · t). Mit der Eigenkreisfrequenz ω₀ und der
+ * Abklingkonstante δ (Wirbelstrombremse) gilt für die Auslenkung φ des Rades
+ *
+ *   φ'' = −ω₀² · (φ − φ_E(t)) − 2δ · φ'
+ *
+ * Nach dem Einschwingen schwingt das Rad mit der Erregerfrequenz:
+ *   φ(t) = φ̂ · sin(ω_E · t − Δφ)
+ * mit der Amplitude φ̂ = φ̂_E · ω₀² / √((ω₀² − ω_E²)² + (2δω_E)²)
+ * und der Phasenverschiebung Δφ = arctan(2δω_E / (ω₀² − ω_E²)) ∈ [0; π].
+ *
+ * Winkel im Bogenmaß, Zeiten in s.
+ */
+
+/** Eigenfrequenz des Rades: f₀ = 0,5 Hz (T₀ = 2 s), ω₀ = π 1/s. */
+export const F0 = 0.5;
+export const OMEGA0 = 2 * Math.PI * F0;
+
+export interface Drive {
+  /** Erregeramplitude φ̂_E (rad). */
+  ampE: number;
+  /** Erregerkreisfrequenz ω_E (1/s). */
+  omegaE: number;
+  /** Abklingkonstante δ (1/s). */
+  delta: number;
+  /** Eigenkreisfrequenz ω₀ (1/s). */
+  omega0: number;
+  /**
+   * Phasenversatz des Motors (rad): φ_E = φ̂_E · sin(ω_E · t + ψ₀). Ändert man
+   * die Drehzahl, bleibt die Drehung des Motors dadurch stetig.
+   */
+  phase0?: number;
+}
+
+/** Zustand: Auslenkung φ (rad) und Winkelgeschwindigkeit φ' (rad/s). */
+export type State = readonly [number, number];
+
+/** Auslenkung des Erregers zur Zeit t. */
+export function driveAngle(d: Drive, t: number): number {
+  return d.ampE * Math.sin(d.omegaE * t + (d.phase0 ?? 0));
+}
+
+/** Phasenwinkel des Erregers ω_E · t + ψ₀. */
+export function drivePhase(d: Drive, t: number): number {
+  return d.omegaE * t + (d.phase0 ?? 0);
+}
+
+/** Winkelbeschleunigung φ'' zum Zustand. */
+export function acceleration(d: Drive, t: number, s: State): number {
+  return -d.omega0 * d.omega0 * (s[0] - driveAngle(d, t)) - 2 * d.delta * s[1];
+}
+
+/** Ein Runge-Kutta-Schritt (4. Ordnung) der Länge h ab der Zeit t. */
+export function step(d: Drive, t: number, s: State, h: number): [number, number] {
+  const w2 = d.omega0 * d.omega0;
+  const k = 2 * d.delta;
+  const p0 = d.phase0 ?? 0;
+  const acc = (tt: number, x: number, v: number) => -w2 * (x - d.ampE * Math.sin(d.omegaE * tt + p0)) - k * v;
+  const [x, v] = s;
+  const a1 = acc(t, x, v);
+  const x2 = x + 0.5 * h * v;
+  const v2 = v + 0.5 * h * a1;
+  const a2 = acc(t + 0.5 * h, x2, v2);
+  const x3 = x + 0.5 * h * v2;
+  const v3 = v + 0.5 * h * a2;
+  const a3 = acc(t + 0.5 * h, x3, v3);
+  const x4 = x + h * v3;
+  const v4 = v + h * a3;
+  const a4 = acc(t + h, x4, v4);
+  return [x + (h / 6) * (v + 2 * v2 + 2 * v3 + v4), v + (h / 6) * (a1 + 2 * a2 + 2 * a3 + a4)];
+}
+
+/** Verhältnis φ̂ / φ̂_E im eingeschwungenen Zustand. */
+export function amplitudeRatio(omegaE: number, omega0: number, delta: number): number {
+  const a = omega0 * omega0 - omegaE * omegaE;
+  const b = 2 * delta * omegaE;
+  return (omega0 * omega0) / Math.sqrt(a * a + b * b);
+}
+
+/** Amplitude φ̂ im eingeschwungenen Zustand (rad). */
+export function steadyAmplitude(d: Drive): number {
+  return d.ampE * amplitudeRatio(d.omegaE, d.omega0, d.delta);
+}
+
+/** Phasenverschiebung Δφ zwischen Erreger und Rad (rad, 0 … π). */
+export function phaseShift(omegaE: number, omega0: number, delta: number): number {
+  return Math.atan2(2 * delta * omegaE, omega0 * omega0 - omegaE * omegaE);
+}
+
+/** Resonanzkreisfrequenz (größte Amplitude) ω_R = √(ω₀² − 2δ²); 0, wenn es kein Maximum gibt. */
+export function resonanceOmega(omega0: number, delta: number): number {
+  const w2 = omega0 * omega0 - 2 * delta * delta;
+  return w2 > 0 ? Math.sqrt(w2) : 0;
+}
+
+/** Eingeschwungener Zustand zur Zeit t (ohne Einschwingvorgang). */
+export function steadyState(d: Drive, t: number): [number, number] {
+  const A = steadyAmplitude(d);
+  const ph = drivePhase(d, t) - phaseShift(d.omegaE, d.omega0, d.delta);
+  return [A * Math.sin(ph), A * d.omegaE * Math.cos(ph)];
+}
+
+/**
+ * Amplitude und Phasenverschiebung, die man aus einem Zustand abliest, wenn
+ * man ihn als harmonische Schwingung mit der Erregerfrequenz deutet
+ * (im eingeschwungenen Zustand exakt).
+ */
+export function readPhasor(d: Drive, t: number, s: State): { amp: number; shift: number } {
+  const amp = Math.hypot(s[0], s[1] / d.omegaE);
+  const own = Math.atan2(s[0], s[1] / d.omegaE);
+  let shift = (drivePhase(d, t) - own) % (2 * Math.PI);
+  if (shift < -Math.PI) shift += 2 * Math.PI;
+  if (shift > Math.PI) shift -= 2 * Math.PI;
+  return { amp, shift };
+}
+
+/**
+ * Integriert ab (t, s) über die Dauer `duration` mit der Schrittweite h.
+ * Bricht ab, sobald |φ| die Grenze `limit` überschreitet.
+ */
+export function integrate(d: Drive, t: number, s: State, duration: number, h: number, limit = Infinity): { t: number; s: [number, number]; exceeded: boolean } {
+  let state: [number, number] = [s[0], s[1]];
+  const n = Math.max(1, Math.round(duration / h));
+  for (let i = 0; i < n; i++) {
+    state = step(d, t, state, h);
+    t += h;
+    if (Math.abs(state[0]) > limit) return { t, s: state, exceeded: true };
+  }
+  return { t, s: state, exceeded: false };
+}
diff --git a/tests/federpendel.test.ts b/tests/federpendel.test.ts
new file mode 100644
index 0000000..7857f66
--- /dev/null
+++ b/tests/federpendel.test.ts
@@ -0,0 +1,112 @@
+import { describe, expect, it } from 'vitest';
+import {
+  acceleration,
+  analyticY,
+  dampedOmega,
+  dampedPeriod,
+  energies,
+  equilibriumExtension,
+  forces,
+  G,
+  initialState,
+  omega0,
+  period,
+  phasor,
+  step,
+  type State,
+} from '../src/simulations/physik/federpendel/model';
+
+/** Integriert mit fester Schrittweite bis zur Zeit T. */
+function run(state: State, m: number, D: number, delta: number, T: number, h = 0.001): State {
+  let s: State = state;
+  const n = Math.round(T / h);
+  for (let i = 0; i < n; i++) s = step(s, m, D, delta, h);
+  return s;
+}
+
+describe('Modell: Federpendel', () => {
+  it('berechnet die Periodendauer T = 2π·√(m/D)', () => {
+    expect(period(0.5, 20)).toBeCloseTo(0.99346, 4);
+    expect(period(1, 10)).toBeCloseTo(1.98692, 4);
+    // vierfache Masse → doppelte Periodendauer, vierfache Federhärte → halbe
+    expect(period(1, 20) / period(0.25, 20)).toBeCloseTo(2, 12);
+    expect(period(0.3, 40) / period(0.3, 10)).toBeCloseTo(0.5, 12);
+    expect(omega0(0.5, 20)).toBeCloseTo(Math.sqrt(40), 12);
+  });
+
+  it('Dehnung in der Ruhelage s₀ = m·g/D (Federkraft = Gewichtskraft)', () => {
+    expect(equilibriumExtension(0.5, 20)).toBeCloseTo(0.24525, 10);
+    const f = forces(0, 0.5, 20);
+    expect(f.spring).toBeCloseTo(0.5 * G, 10);
+    expect(f.net).toBeCloseTo(0, 12);
+    // lineares Kraftgesetz: resultierende Kraft = −D·y
+    expect(forces(0.03, 0.5, 20).net).toBeCloseTo(-0.6, 10);
+    expect(forces(-0.05, 0.5, 20).net).toBeCloseTo(1, 10);
+  });
+
+  it('Anfangszustand passt zu y = ŷ·sin(ωt + φ₀)', () => {
+    const down = initialState(0.05, -Math.PI / 2, 0.5, 20, 0);
+    expect(down[0]).toBeCloseTo(-0.05, 12);
+    expect(down[1]).toBeCloseTo(0, 12);
+    const push = initialState(0.05, 0, 0.5, 20, 0);
+    expect(push[0]).toBeCloseTo(0, 12);
+    expect(push[1]).toBeCloseTo(0.05 * Math.sqrt(40), 12);
+  });
+
+  it('Runge-Kutta stimmt mit der exakten Lösung überein (ungedämpft und gedämpft)', () => {
+    for (const delta of [0, 0.3, 1.5]) {
+      const s = run(initialState(0.05, 0.4, 0.5, 20, delta), 0.5, 20, delta, 7.5);
+      expect(s[0]).toBeCloseTo(analyticY(7.5, 0.05, 0.4, 0.5, 20, delta), 8);
+    }
+  });
+
+  it('nach einer Periodendauer ist der Zustand wieder derselbe', () => {
+    const s0 = initialState(0.08, -Math.PI / 2, 0.4, 25, 0);
+    const T = period(0.4, 25);
+    const s = run(s0, 0.4, 25, 0, T, T / 2000);
+    expect(s[0]).toBeCloseTo(s0[0], 9);
+    expect(s[1]).toBeCloseTo(s0[1], 8);
+  });
+
+  it('Energie bleibt ohne Dämpfung erhalten: ½Dy² + ½mv² = ½Dŷ²', () => {
+    const m = 0.5;
+    const D = 20;
+    const amp = 0.05;
+    let s: State = initialState(amp, 1, m, D, 0);
+    for (let k = 0; k < 5; k++) {
+      s = run(s, m, D, 0, 0.37);
+      const e = energies(s, m, D, -amp);
+      expect(e.osc + e.kin).toBeCloseTo(0.5 * D * amp * amp, 9);
+      // Spann-, Lage- und Bewegungsenergie zusammen sind ebenfalls konstant
+      expect(e.spring + e.grav + e.kin).toBeCloseTo(0.5 * D * equilibriumExtension(m, D) ** 2 + m * G * amp + 0.5 * D * amp * amp, 9);
+    }
+  });
+
+  it('Dämpfung: Amplitude nimmt in einer Periode um e^(−δ·T_d) ab', () => {
+    const m = 0.5;
+    const D = 20;
+    const delta = 0.4;
+    const Td = dampedPeriod(m, D, delta);
+    expect(Td).toBeCloseTo((2 * Math.PI) / Math.sqrt(40 - 0.16), 12);
+    expect(Td).toBeGreaterThan(period(m, D));
+    const s0 = initialState(0.05, 0.7, m, D, delta);
+    const s1 = run(s0, m, D, delta, Td, Td / 4000);
+    expect(phasor(s1, m, D, delta).amp / phasor(s0, m, D, delta).amp).toBeCloseTo(Math.exp(-delta * Td), 8);
+  });
+
+  it('Zeiger: Länge = Amplitude, Projektion = Elongation', () => {
+    const z = phasor(initialState(0.05, 2.1, 0.5, 20, 0), 0.5, 20, 0);
+    expect(z.amp).toBeCloseTo(0.05, 12);
+    expect(z.phase).toBeCloseTo(2.1, 12);
+    const zd = phasor(initialState(0.03, -1.2, 0.5, 20, 0.5), 0.5, 20, 0.5);
+    expect(zd.amp).toBeCloseTo(0.03, 12);
+    expect(zd.phase).toBeCloseTo(-1.2, 12);
+  });
+
+  it('Beschleunigung a = −ω²·y (ohne Dämpfung) und Grenzfälle', () => {
+    expect(acceleration([0.02, 0.3], 0.5, 20, 0)).toBeCloseTo(-0.8, 12);
+    expect(acceleration([0, 0.3], 0.5, 20, 0.5)).toBeCloseTo(-0.3, 12);
+    expect(dampedOmega(0.5, 20, 7)).toBe(0);
+    expect(dampedPeriod(0.5, 20, 7)).toBe(Infinity);
+  });
+});
diff --git a/tests/resonanz.test.ts b/tests/resonanz.test.ts
new file mode 100644
index 0000000..b69bcc5
--- /dev/null
+++ b/tests/resonanz.test.ts
@@ -0,0 +1,85 @@
+import { describe, expect, it } from 'vitest';
+import {
+  amplitudeRatio,
+  F0,
+  integrate,
+  OMEGA0,
+  phaseShift,
+  readPhasor,
+  resonanceOmega,
+  steadyAmplitude,
+  steadyState,
+  type Drive,
+} from '../src/simulations/physik/resonanz/model';
+
+const DEG = Math.PI / 180;
+const drive = (fE: number, delta: number, ampDeg = 5): Drive => ({ ampE: ampDeg * DEG, omegaE: 2 * Math.PI * fE, delta, omega0: OMEGA0 });
+
+describe('Modell: Erzwungene Schwingung (Pohlsches Rad)', () => {
+  it('Eigenfrequenz f₀ = 0,5 Hz', () => {
+    expect(F0).toBe(0.5);
+    expect(OMEGA0).toBeCloseTo(Math.PI, 12);
+  });
+
+  it('Amplitudenverhältnis: 1 bei kleiner, Q bei Eigen-, → 0 bei großer Erregerfrequenz', () => {
+    expect(amplitudeRatio(1e-6, OMEGA0, 0.25)).toBeCloseTo(1, 9);
+    // bei ω_E = ω₀: φ̂/φ̂_E = ω₀ / (2δ)
+    expect(amplitudeRatio(OMEGA0, OMEGA0, 0.25)).toBeCloseTo(OMEGA0 / 0.5, 12);
+    expect(amplitudeRatio(20 * OMEGA0, OMEGA0, 0.25)).toBeLessThan(0.003);
+    // konkreter Wert: φ̂_E = 5°, δ = 0,25 1/s, f_E = f₀ → φ̂ ≈ 31,4°
+    expect(steadyAmplitude(drive(0.5, 0.25)) / DEG).toBeCloseTo(31.416, 2);
+  });
+
+  it('Phasenverschiebung 0 → π/2 → π', () => {
+    expect(phaseShift(0.01, OMEGA0, 0.25)).toBeCloseTo(0, 2);
+    expect(phaseShift(OMEGA0, OMEGA0, 0.25)).toBeCloseTo(Math.PI / 2, 12);
+    expect(phaseShift(30, OMEGA0, 0.25)).toBeGreaterThan(Math.PI * 0.99);
+    // stärkere Dämpfung → flacherer Übergang
+    expect(phaseShift(0.8 * OMEGA0, OMEGA0, 1)).toBeGreaterThan(phaseShift(0.8 * OMEGA0, OMEGA0, 0.1));
+  });
+
+  it('Resonanzfrequenz ω_R = √(ω₀² − 2δ²) liegt etwas unter ω₀ und ist das Maximum', () => {
+    const delta = 0.8;
+    const wr = resonanceOmega(OMEGA0, delta);
+    expect(wr).toBeCloseTo(Math.sqrt(Math.PI ** 2 - 1.28), 12);
+    const peak = amplitudeRatio(wr, OMEGA0, delta);
+    expect(peak).toBeGreaterThan(amplitudeRatio(wr * 1.01, OMEGA0, delta));
+    expect(peak).toBeGreaterThan(amplitudeRatio(wr * 0.99, OMEGA0, delta));
+    expect(resonanceOmega(OMEGA0, 3)).toBe(0);
+  });
+
+  it('numerische Lösung erreicht den eingeschwungenen Zustand (aus der Ruhe gestartet)', () => {
+    for (const [fE, delta] of [
+      [0.3, 0.25],
+      [0.5, 0.4],
+      [0.9, 0.6],
+    ] as const) {
+      const d = drive(fE, delta);
+      const res = integrate(d, 0, [0, 0], 30 / delta, 0.002);
+      const exact = steadyState(d, res.t);
+      expect(res.s[0]).toBeCloseTo(exact[0], 6);
+      expect(res.s[1]).toBeCloseTo(exact[1], 5);
+      const ph = readPhasor(d, res.t, res.s);
+      expect(ph.amp).toBeCloseTo(steadyAmplitude(d), 6);
+      expect(ph.shift).toBeCloseTo(phaseShift(d.omegaE, OMEGA0, delta), 5);
+    }
+  });
+
+  it('eingeschwungener Zustand bleibt eingeschwungen', () => {
+    const d = drive(0.45, 0.2);
+    const s0 = steadyState(d, 1.3);
+    const res = integrate(d, 1.3, s0, 7.7, 0.001);
+    const exact = steadyState(d, res.t);
+    expect(res.s[0]).toBeCloseTo(exact[0], 8);
+  });
+
+  it('Resonanzkatastrophe: Grenze wird bei kleiner Dämpfung überschritten', () => {
+    const d = drive(0.5, 0.03, 10);
+    const res = integrate(d, 0, [0, 0], 60, 0.002, 120 * DEG);
+    expect(res.exceeded).toBe(true);
+    expect(res.t).toBeGreaterThan(5);
+    expect(res.t).toBeLessThan(20);
+    const calm = integrate(drive(0.5, 0.5, 10), 0, [0, 0], 60, 0.002, 120 * DEG);
+    expect(calm.exceeded).toBe(false);
+  });
+});
