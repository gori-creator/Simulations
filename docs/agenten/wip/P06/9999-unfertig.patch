+      g.strokeStyle = radColor();
+      g.lineWidth = 2.6;
+      g.beginPath();
+      g.moveTo(lx, ly);
+      g.lineTo(lx + 14, ly);
+      g.stroke();
+      text(g, ctx.t('rad'), lx + 18, ly + 0.5, { font: `700 ${fs}px ${theme.font}`, color: radColor(), align: 'left' });
+      lx += 18 + g.measureText(ctx.t('rad')).width + 14;
+      g.strokeStyle = eColor();
+      g.lineWidth = 2;
+      g.setLineDash([5, 3]);
