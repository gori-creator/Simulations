+          g.moveTo(cx, cy);
+          g.arc(cx, cy, rr, 0, -a, true);
+          g.closePath();
+          g.fill();
+          g.beginPath();
+          g.arc(cx, cy, rr, 0, -a, true);
+          g.stroke();
+          const mid = a / 2;
+          const lr = rr + (sm ? 8 : 10);
+          text(g, 'φ', cx + lr * Math.cos(mid), cy - lr * Math.sin(mid), { font: `italic 700 ${sm ? 12 : 14}px ${theme.mathFont}`, color: aColor() });
