+          arrowPx(cx, cy, tx, ty, yColor(), sm ? 2.6 : 3, sm ? 9 : 11);
+          if (!ctx.locked) {
+            const hl = drag?.kind === 'phasor' ? 1 : hoverKind === 'phasor' ? 0.6 : 0.25;
