+      plot.segment([F0, 0], [F0, yMax * 2], { color: theme.muted, width: 1.2, dash: [4, 4] });
+      plot.text(F0, 0, ctx.t('f0'), { color: theme.muted, size: 12, weight: 'bold', align: 'left', baseline: 'bottom', offset: [4, -4] });
