+      g.moveTo(x + cw / 2, cyc + ch * 0.5);
+      g.bezierCurveTo(x + cw / 2 + 14, cyc + ch * 0.5, x + cw / 2 + 10, cyc + ch + 12, x + cw / 2 + 26, cyc + ch + 10);
