+          g.lineWidth = 2.2;
+          g.beginPath();
+          g.moveTo(cx, cy);
+          g.lineTo(tx, ty);
+          g.stroke();
+          g.restore();
+          g.fillStyle = yColor();
+          g.beginPath();
+          g.arc(tx, ty, 3.2, 0, TAU);
+          g.fill();
