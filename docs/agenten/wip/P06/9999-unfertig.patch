+
+    /* ---------- Ablauf ---------- */
+    function autoStep(): void {
+      if (!auto) return;
+      if (auto.i >= SWEEP.length) {
+        auto = null;
+        updateReadouts();
+        return;
+      }
+      const f = SWEEP[auto.i]!;
+      ctx.set({ fE: f });
+      skipTransient(true);
+      auto.i++;
+      auto.next = performance.now() + (prefersReducedMotion() ? 120 : 420);
+      updateReadouts();
+    }
+
+    restart();
+
+    return {
+      update(changed, source) {
+        if (source === 'init' || source === 'replace') {
+          restart();
+          points = [];
+          auto = null;
+          ctx.clock.pause();
+        } else {
+          if (changed.has('fE')) {
+            if (broken && source === 'input') restart();
+            resetTracking();
+          }
+          if (changed.has('damp') || changed.has('amp')) {
+            points = [];
+            if (broken && source === 'input') restart();
+            resetTracking();
+          }
+          if (source === 'input' && (changed.has('fE') || changed.has('damp') || changed.has('amp'))) auto = null;
+        }
+        lay = computeLayout();
+        plotT.resize();
+        plotR.resize();
+        plotP.resize();
+        updateReadouts();
+      },
+
+      action(id) {
+        if (ctx.locked) return;
+        if (id === 'go') {
+          auto = null;
+          restart();
+          updateReadouts();
+          ctx.clock.play();
+        } else if (id === 'skip') {
+          if (broken) return;
+          auto = null;
+          skipTransient(false);
+          updateReadouts();
+          ctx.requestRender();
+        } else if (id === 'auto') {
+          if (auto) {
+            auto = null;
+          } else {
+            if (broken) restart();
+            points = [];
+            auto = { i: 0, next: 0 };
+            ctx.clock.play();
+          }
+          updateReadouts();
+        } else if (id === 'clear') {
+          points = [];
+          updateReadouts();
+        }
+      },
+
+      tick(dt) {
+        if (broken) return;
+        if (auto && performance.now() >= auto.next) autoStep();
+        const h = dt * SPEED[p.speed as Speed];
+        const d = drive();
+        let finished = false;
+        stepper.run(h, (hh) => {
+          if (broken) return;
+          s = step(d, t, s, hh);
+          t += hh;
+          const a = Math.abs(s[0]);
+          if (a > LIMIT) {
+            s = [Math.sign(s[0]) * LIMIT, 0];
+            finished = true;
+            broken = true;
+            return;
+          }
+          cycleMax = Math.max(cycleMax, a);
+          if (t >= nextSample - 1e-9) {
+            hist.t.push(t);
+            hist.phi.push(s[0]);
+            hist.e.push(driveAngle(d, t));
+            nextSample += SAMPLE;
+          }
+          // Ende einer Erregerperiode: Amplitude dieser Periode festhalten
+          const ci = Math.floor(drivePhase(d, t) / TAU);
+          if (ci !== cycleIndex) {
+            cycleIndex = ci;
+            amps.push(cycleMax);
+            if (amps.length > 6) amps.shift();
+            liveAmp = cycleMax;
+            liveShift = readPhasor(d, t, s).shift;
+            cycleMax = a;
+            const k = amps.length;
+            const stable =
+              k >= 3 && t - tChange > 3 / p.fE && Math.abs(amps[k - 1]! - amps[k - 2]!) < 0.004 * amps[k - 1]! + 0.02 * DEG && Math.abs(amps[k - 2]! - amps[k - 3]!) < 0.004 * amps[k - 2]! + 0.02 * DEG;
+            if (stable && !steady) {
+              steady = true;
+              record(false);
+            } else if (!stable && steady && Math.abs(amps[k - 1]! - amps[k - 2]!) > 0.02 * amps[k - 1]!) steady = false;
+          } else liveAmp = Math.max(liveAmp, cycleMax);
+        });
+        if (finished) breakDown();
+        if (steady !== wasSteady) {
+          wasSteady = steady;
+          updateReadouts();
+        }
+        // alte Messwerte verwerfen
+        const W = niceWindow(Math.max(4, 3.2 / p.fE));
+        const cut = hist.t.findIndex((tt) => tt >= t - W - 1);
+        if (cut > 400) {
+          hist.t.splice(0, cut);
+          hist.phi.splice(0, cut);
+          hist.e.splice(0, cut);
+        }
+        updateNow();
+      },
+
+      resetTime() {
+        auto = null;
+        restart();
+        updateReadouts();
+      },
+
+      render() {
+        const now = performance.now();
+        const dt = Math.min(0.1, (now - lastFrame) / 1000);
+        lastFrame = now;
+        lay = computeLayout();
+        plotT.resize();
+        plotR.resize();
+        plotP.resize();
+        surface.begin();
+        drawScene(lay.scene);
+        drawTime(lay.time, dt);
+        drawRes(lay.res);
+        if (lay.phase) drawPhase(lay.phase);
+        if (pop.running || flash.running || (jumpNote && now < jumpNote.until)) ctx.requestRender();
+      },
+
+      destroy: () => surface.destroy(),
+    };
+  },
+});
