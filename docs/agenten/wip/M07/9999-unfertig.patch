+      const a1 = -(((an.th1 + an.al) * Math.PI) / 180);
+      if (halves > 0) {
+        const mid = -(((an.th1 + an.al / 2) * Math.PI) / 180);
+        for (const [x0, x1, n] of [
+          [a0, mid, 1],
+          [mid, a1, 1],
+        ] as [number, number, number][]) {
