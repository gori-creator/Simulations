+        g.translate(x, y);
+        g.scale(s, s);
+        g.strokeStyle = col.line();
+        g.lineWidth = 2.6;
+        g.lineCap = 'round';
+        g.beginPath();
+        g.moveTo(-5, -5);
+        g.lineTo(5, 5);
+        g.moveTo(5, -5);
+        g.lineTo(-5, 5);
+        g.stroke();
+        g.restore();
