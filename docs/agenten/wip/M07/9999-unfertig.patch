+        const pm = toPx(c.m);
+        const ps = toPx(c.s1);
+        g.save();
+        g.globalAlpha = st.finish;
+        rightMark(pm, unit(pb[0] - pm[0], pb[1] - pm[1]), unit(ps[0] - pm[0], ps[1] - pm[1]), col.right(), W ? 12 : 10);
