+        grad.addColorStop(1, metalB);
+        g.strokeStyle = grad;
+        g.lineWidth = 7;
+        g.lineCap = 'round';
+        g.beginPath();
+        g.moveTo(hinge[0], hinge[1]);
+        g.lineTo(end[0], end[1]);
+        g.stroke();
+        return end;
+      };
+      // Nadel
+      const nEnd = leg(pin, 0.16);
+      g.strokeStyle = metalB;
+      g.lineWidth = 2;
+      g.beginPath();
+      g.moveTo(nEnd[0], nEnd[1]);
+      g.lineTo(pin[0], pin[1]);
+      g.stroke();
+      // Bleistift-Schenkel
+      const pEnd = leg(pen, 0.3);
+      const wood = theme.dark ? '#e0b45c' : '#d99a2b';
+      g.strokeStyle = wood;
+      g.lineWidth = 6;
+      g.lineCap = 'butt';
+      const tipStart: [number, number] = [pen[0] + (pEnd[0] - pen[0]) * 0.32, pen[1] + (pEnd[1] - pen[1]) * 0.32];
+      g.beginPath();
+      g.moveTo(pEnd[0], pEnd[1]);
+      g.lineTo(tipStart[0], tipStart[1]);
+      g.stroke();
+      // angespitzte Mine
+      const [lx, ly] = unit(pen[0] - tipStart[0], pen[1] - tipStart[1]);
+      g.fillStyle = theme.dark ? '#f1d9a6' : '#f0d39b';
+      g.beginPath();
+      g.moveTo(tipStart[0] - ly * 3, tipStart[1] + lx * 3);
+      g.lineTo(tipStart[0] + ly * 3, tipStart[1] - lx * 3);
+      g.lineTo(pen[0], pen[1]);
+      g.closePath();
+      g.fill();
+      g.fillStyle = theme.dark ? '#cfd6e0' : '#2b313b';
+      const gStart: [number, number] = [pen[0] - lx * 5, pen[1] - ly * 5];
+      g.beginPath();
+      g.moveTo(gStart[0] - ly * 1.4, gStart[1] + lx * 1.4);
+      g.lineTo(gStart[0] + ly * 1.4, gStart[1] - lx * 1.4);
+      g.lineTo(pen[0], pen[1]);
+      g.closePath();
+      g.fill();
+      // Gelenk und Griff
+      const gripEnd: [number, number] = [hinge[0] + n[0] * 16, hinge[1] + n[1] * 16];
+      g.strokeStyle = metalB;
+      g.lineWidth = 6;
+      g.lineCap = 'round';
+      g.beginPath();
+      g.moveTo(hinge[0], hinge[1]);
+      g.lineTo(gripEnd[0], gripEnd[1]);
+      g.stroke();
+      g.beginPath();
+      g.arc(hinge[0], hinge[1], 7, 0, Math.PI * 2);
+      const hg = g.createRadialGradient(hinge[0] - 2, hinge[1] - 2, 1, hinge[0], hinge[1], 7);
+      hg.addColorStop(0, theme.dark ? '#ffffff' : '#e7ecf3');
+      hg.addColorStop(1, metalB);
+      g.fillStyle = hg;
+      g.fill();
+      g.restore();
+    }
