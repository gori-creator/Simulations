+      // Namen A und B an den Schenkeln, S am Scheitel
+      const nameAt = (th: number, nm: string) => {
+        const t = armHandleDist(th);
+        const u = dir(th);
+        const q = toPx([an.s[0] + u[0] * t, an.s[1] + u[1] * t]);
+        const nrm: [number, number] = th === an.th1 ? [Math.sin((th * Math.PI) / 180), Math.cos((th * Math.PI) / 180)] : [-Math.sin((th * Math.PI) / 180), -Math.cos((th * Math.PI) / 180)];
+        haloText(nm, q[0] + nrm[0] * 17, q[1] + nrm[1] * 17, `800 ${W ? 15 : 13}px ${theme.font}`, theme.text);
+      };
+      nameAt(an.th1, 'A');
+      nameAt(an.th1 + an.al, 'B');
+      const back = dir(bisectorDir(an) + 180);
