+      const list = constrWhat() === 'mittel' ? stepsMittel() : stepsWinkel();
+      stepsCache = { key, steps: list };
+      return list;
+    }
+
+    function stepsMittel(): Step[] {
+      const a = A();
+      const b = B();
+      const c = constructBisector(a, b);
+      const dAB = (Math.atan2(b[1] - a[1], b[0] - a[0]) * 180) / Math.PI;
+      const sw = 64;
+      const [e0, e1] = extendToPaper(c.s1, c.s2);
+      return [
+        { text: ctx.t('m0'), ops: [] },
+        { text: ctx.t('m1'), ops: [compassIn(a, dAB - sw, c.r)] },
+        { text: ctx.t('m2'), ops: [arcOp(a, c.r, dAB - sw, dAB + sw)] },
+        { text: ctx.t('m3'), ops: [compassMove(b, dAB + 180 + sw, c.r), arcOp(b, c.r, dAB + 180 + sw, dAB + 180 - sw)] },
+        {
+          text: ctx.t('m4'),
+          ops: [
+            markOp([
+              { p: c.s1, label: 'S₁' },
+              { p: c.s2, label: 'S₂' },
+            ]),
+          ],
+        },
+        { text: ctx.t('m5'), ops: [compassOut(), ...rulerLine(c.s1, c.s2, [e0, e1])] },
+        { text: ctx.t('m6'), ops: [markOp([{ p: c.m, label: 'M' }]), finishOp()] },
+      ];
+    }
+
+    function stepsWinkel(): Step[] {
+      const an = angle();
+      const r1 = 4;
+      const c = constructAngleBisector(an, r1);
+      const dW1 = (Math.atan2(c.w[1] - c.p1[1], c.w[0] - c.p1[0]) * 180) / Math.PI;
+      const dW2 = (Math.atan2(c.w[1] - c.p2[1], c.w[0] - c.p2[0]) * 180) / Math.PI;
+      const far = extendToPaper(an.s, c.w)[1];
+      return [
+        { text: ctx.t('w0'), ops: [] },
+        { text: ctx.t('w1'), ops: [compassIn(an.s, an.th1 - 14, r1)] },
+        {
+          text: ctx.t('w2'),
+          ops: [
+            arcOp(an.s, r1, an.th1 - 14, an.th1 + an.al + 14, 1500),
+            markOp([
+              { p: c.p1, label: 'P₁' },
+              { p: c.p2, label: 'P₂' },
+            ]),
+          ],
+        },
+        { text: ctx.t('w3'), ops: [compassMove(c.p1, dW1 - 26, c.r2), arcOp(c.p1, c.r2, dW1 - 26, dW1 + 26)] },
+        { text: ctx.t('w4'), ops: [compassMove(c.p2, dW2 + 26, c.r2), arcOp(c.p2, c.r2, dW2 + 26, dW2 - 26), markOp([{ p: c.w, label: 'W' }])] },
+        { text: ctx.t('w5'), ops: [compassOut(), ...rulerLine(an.s, c.w, [an.s, far])] },
+        { text: ctx.t('w6'), ops: [finishOp()] },
+      ];
+    }
+
+    const stepDur = (st: Step) => st.ops.reduce((s, o) => s + o.dur, 0);
+    const stepRunning = () => {
+      const st = steps()[stepIdx];
+      return !!st && performance.now() - stepStart < stepDur(st);
+    };
+
+    /** Zeichenzustand der Konstruktion zum aktuellen Zeitpunkt. */
+    function constrState(): CState {
+      const s = emptyState();
+      const list = steps();
+      const now = performance.now();
+      for (let i = 1; i <= stepIdx && i < list.length; i++) {
+        const st = list[i]!;
+        let el = i < stepIdx || reduced ? Infinity : now - stepStart;
+        for (const op of st.ops) {
+          const t = clamp(el / op.dur, 0, 1);
+          // abgeschlossene Bögen und Marken bleiben, Zirkel/Lineal zeigen den letzten Stand
+          op.apply(s, t);
+          el -= op.dur;
+          if (el < 0) break;
+        }
+      }
+      return s;
+    }
+
+    function nextStep(): void {
+      const list = steps();
+      if (stepRunning()) return;
+      if (stepIdx >= list.length - 1) return;
+      stepIdx++;
+      stepStart = performance.now();
+      updateReadouts();
+      ctx.requestRender();
+    }
+
+    function restart(): void {
+      stepIdx = 0;
+      stepStart = -Infinity;
+      autoPlay = false;
+      updateReadouts();
+      ctx.requestRender();
+    }
+
+    /* ---------- Ergebnisse ---------- */
+    function updateReadouts(): void {
+      const m = mode();
+      ctx.readout('dist', null);
+      ctx.readout('angle', null);
+      ctx.readout('trace', null);
+      ctx.readout('step', null);
+      ctx.readout('u', null);
+      if (m === 'mittel') {
+        const v = closer(P, A(), B());
+        ctx.readout('dist', tr('distRead', { a: cmText(dist(P, A())), b: cmText(dist(P, B())), v: ctx.t(v === 'A' ? 'vA' : v === 'B' ? 'vB' : 'vEq') }));
