+    const B = (): Pt => [p.bx, p.by];
+    const C = (): Pt => [p.cx, p.cy];
+    const angle = (): Angle => ({ s: [p.sx, p.sy], th1: p.th, al: p.al });
+
+    /* ---------- Zustand ---------- */
+    let P: Pt = [6, 3];
+    let PW: Pt = [10, 4];
+    let traceM: Pt[] = [];
+    let traceW: Pt[] = [];
+    const tracePop = new Tween(500, ease.outBack);
