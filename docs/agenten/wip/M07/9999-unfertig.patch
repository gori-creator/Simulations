+    function drawRuler(r: NonNullable<CState['ruler']>): void {
+      const g = surface.g;
+      const theme = ctx.theme;
+      const { cell } = layout();
+      const a = toPx(r.a);
+      const b = toPx(r.b);
+      const [ux, uy] = unit(b[0] - a[0], b[1] - a[1]);
+      let nx = -uy;
+      let ny = ux;
+      if (ny < 0) {
+        nx = -nx;
+        ny = -ny;
+      }
+      const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
+      const off = r.slide * 40;
+      const w = 1.1 * cell;
+      const o: [number, number] = [a[0] - ux * 30 + nx * (1 + off), a[1] - uy * 30 + ny * (1 + off)];
+      const L2 = len + 60;
+      g.save();
+      g.globalAlpha = r.alpha;
+      g.save();
+      g.shadowColor = theme.dark ? 'rgba(0,0,0,0.5)' : 'rgba(16,24,40,0.18)';
+      g.shadowBlur = 10;
+      g.shadowOffsetY = 3;
+      g.beginPath();
+      g.moveTo(o[0], o[1]);
+      g.lineTo(o[0] + ux * L2, o[1] + uy * L2);
+      g.lineTo(o[0] + ux * L2 + nx * w, o[1] + uy * L2 + ny * w);
+      g.lineTo(o[0] + nx * w, o[1] + ny * w);
+      g.closePath();
+      g.fillStyle = theme.dark ? 'rgba(52,64,84,0.8)' : 'rgba(255,251,232,0.85)';
+      g.fill();
+      g.restore();
+      g.strokeStyle = withAlpha(theme.text, 0.35);
+      g.lineWidth = 1;
+      g.stroke();
+      g.strokeStyle = withAlpha(theme.text, 0.7);
+      g.beginPath();
+      const step = cell / 5;
+      for (let k = 0; k * step <= L2; k++) {
+        const l = k % 10 === 0 ? 0.36 : k % 5 === 0 ? 0.24 : 0.14;
+        if (cell < 18 && k % 5 !== 0) continue;
+        const x = o[0] + ux * k * step;
+        const y = o[1] + uy * k * step;
+        g.moveTo(x, y);
+        g.lineTo(x + nx * w * l, y + ny * w * l);
+      }
+      g.stroke();
+      g.restore();
+    }
+
+    function drawKonstr(): void {
