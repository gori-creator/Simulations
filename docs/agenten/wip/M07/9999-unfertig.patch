+
+    /* ---------- Modus: Umkreis ---------- */
+    function drawUmkreis(): void {
+      const g = surface.g;
+      const theme = ctx.theme;
+      const W = wide();
+      const pts = [A(), B(), C()];
+      const px = pts.map(toPx);
+      const u = circumcenter(pts[0]!, pts[1]!, pts[2]!);
+      const colors = [col.a(), col.b(), theme.series[5]!];
+      // Dreieck
+      g.save();
+      g.beginPath();
+      px.forEach(([x, y], i) => (i ? g.lineTo(x, y) : g.moveTo(x, y)));
+      g.closePath();
+      g.fillStyle = withAlpha(theme.text, theme.dark ? 0.08 : 0.05);
+      g.fill();
+      g.restore();
+      // Mittelsenkrechten der Seiten
+      const sides: [number, number][] = [
+        [0, 1],
+        [1, 2],
+        [2, 0],
+      ];
+      sides.forEach(([i, j], k) => {
+        const { m, d } = perpBisector(pts[i]!, pts[j]!);
+        const pm = toPx(m);
+        const dpx: [number, number] = unit(d[0], -d[1]);
+        fullLine(pm, [pm[0] + dpx[0], pm[1] + dpx[1]], withAlpha(colors[k]!, 0.85), 2);
