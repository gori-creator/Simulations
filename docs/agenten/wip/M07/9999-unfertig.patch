+      g.beginPath();
+      g.moveTo(o[0] - d[0] * L2, o[1] - d[1] * L2);
+      g.lineTo(o[0] + d[0] * L2, o[1] + d[1] * L2);
+      g.lineTo(o[0] + d[0] * L2 + n[0] * L2, o[1] + d[1] * L2 + n[1] * L2);
+      g.lineTo(o[0] - d[0] * L2 + n[0] * L2, o[1] - d[1] * L2 + n[1] * L2);
