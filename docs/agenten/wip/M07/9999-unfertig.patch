+    /* ---------- Konstruktion: Ablauf ---------- */
+    interface Step {
+      text: string;
+      ops: Op[];
+    }
+
+    function compassIn(pin: Pt, ang: number, r: number, dur = 1100): Op {
+      return {
+        dur,
+        apply(s, t) {
+          const e = ease.outCubic(t);
+          s.compass = { pin: [pin[0] + (1 - e) * 2.5, pin[1] - (1 - e) * 2], ang: ang - (1 - e) * 40, r: lerp(r * 0.35, r, ease.inOutCubic(t)), alpha: Math.min(1, t * 2), ref: ang };
+        },
+      };
+    }
+    function compassMove(pin: Pt, ang: number, r: number, dur = 900): Op {
+      return {
+        dur,
+        apply(s, t) {
+          const c = s.compass ?? { pin, ang, r, alpha: 1, ref: ang };
+          const e = ease.inOutCubic(t);
+          let da = norm360(ang - c.ang);
+          if (da > 180) da -= 360;
+          s.compass = { pin: [lerp(c.pin[0], pin[0], e), lerp(c.pin[1], pin[1], e)], ang: c.ang + da * e, r: lerp(c.r, r, e), alpha: 1, ref: c.ang + da * e };
+        },
+      };
+    }
+    function arcOp(c: Pt, r: number, a0: number, a1: number, dur = 1300): Op {
+      return {
+        dur,
+        apply(s, t) {
+          const e = ease.inOutCubic(t);
+          const a = a0 + (a1 - a0) * e;
+          s.arcs.push({ c, r, a0, a1: a });
+          s.compass = { pin: c, ang: a, r, alpha: 1, ref: (a0 + a1) / 2 };
+        },
+      };
+    }
+    function compassOut(dur = 600): Op {
+      return {
+        dur,
+        apply(s, t) {
+          if (!s.compass) return;
+          const c = s.compass;
+          s.compass = t >= 1 ? null : { ...c, pin: [c.pin[0] + t * 2.5, c.pin[1] + t * 1.5], alpha: 1 - t };
+        },
+      };
+    }
+    function markOp(points: { p: Pt; label: string }[], dur = 650): Op {
+      return {
+        dur,
+        apply(s, t) {
+          points.forEach((q, i) => s.points.push({ ...q, pop: clamp(t * points.length - i * 0.6, 0, 1) }));
+        },
+      };
+    }
+    function rulerLine(a: Pt, b: Pt, ext: [Pt, Pt]): Op[] {
+      return [
+        {
+          dur: 700,
+          apply(s, t) {
+            s.ruler = { a, b, alpha: t, slide: 1 - ease.outCubic(t) };
+          },
+        },
+        {
+          dur: 900,
+          apply(s, t) {
+            s.ruler = { a, b, alpha: 1, slide: 0 };
+            s.line = { a: ext[0], b: ext[1], t: ease.inOutCubic(t) };
+          },
+        },
+        {
+          dur: 500,
+          apply(s, t) {
+            s.ruler = t >= 1 ? null : { a, b, alpha: 1 - t, slide: t * 0.6 };
+          },
+        },
+      ];
+    }
+    const finishOp = (dur = 700): Op => ({
+      dur,
+      apply(s, t) {
