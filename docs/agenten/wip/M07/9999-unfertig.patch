+      const W = wide();
+      const st = constrState();
+      const pencil = theme.dark ? '#cfd6e0' : '#3a414d';
+      const isM = constrWhat() === 'mittel';
+      // Grundfigur
+      if (isM) {
+        const pa = toPx(A());
+        const pb = toPx(B());
+        segment(pa, pb, theme.text, 2.8);
+      } else drawAngleBase(angle(), false, st.finish);
+      // Bögen (Bleistift)
+      for (const a of st.arcs) {
+        const c = toPx(a.c);
+        const rpx = a.r * layout().cell;
+        g.save();
+        g.strokeStyle = pencil;
+        g.lineWidth = 1.8;
+        g.globalAlpha = 0.85;
+        g.beginPath();
+        const s0 = -((a.a0 * Math.PI) / 180);
+        const s1 = -((a.a1 * Math.PI) / 180);
+        g.arc(c[0], c[1], rpx, s0, s1, a.a1 > a.a0);
+        g.stroke();
+        g.restore();
+      }
