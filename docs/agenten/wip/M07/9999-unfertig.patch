+      if (isM) {
+        const pa = toPx(A());
+        const pb = toPx(B());
+        handle(pa, 'a', theme.text, 'A', [pa[0] - pb[0], pa[1] - pb[1]]);
+        handle(pb, 'b', theme.text, 'B', [pb[0] - pa[0], pb[1] - pa[1]]);
