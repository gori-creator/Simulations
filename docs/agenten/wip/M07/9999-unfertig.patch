+      const cy = px.reduce((s, q) => s + q[1], 0) / 3;
+      (['a', 'b', 'c'] as const).forEach((id, i) => handle(px[i]!, id, theme.text, id.toUpperCase(), [px[i]![0] - cx, px[i]![1] - cy]));
+    }
+
+    /* ---------- Karten ---------- */
+    function distCard(R: Rect): number {
+      const g = surface.g;
+      const theme = ctx.theme;
+      const W = wide();
+      const pad = W ? 14 : 12;
+      const isM = mode() === 'mittel';
+      let v1: number;
+      let v2: number;
+      let verdict: string;
+      let eq: boolean;
+      let n1: string;
+      let n2: string;
+      if (isM) {
+        v1 = dist(P, A());
+        v2 = dist(P, B());
+        const c = closer(P, A(), B());
+        eq = c === 'equal';
+        verdict = ctx.t(eq ? 'equalAB' : c === 'A' ? 'closerA' : 'closerB');
+        n1 = '|PA|';
+        n2 = '|PB|';
+      } else {
+        [v1, v2] = armDistances(PW, angle());
+        eq = onW();
+        verdict = ctx.t(eq ? 'equal12' : v1 < v2 ? 'closer1' : 'closer2');
+        n1 = 'd₁';
+        n2 = 'd₂';
+      }
+      const f = `600 ${W ? 12.5 : 12}px ${theme.font}`;
+      const vRows = wrap(verdict, R.w - 2 * pad, `700 ${W ? 13 : 12}px ${theme.font}`);
+      const h = (W ? 30 : 26) + 2 * (W ? 26 : 22) + 8 + vRows.length * 17 + 10;
+      card({ x: R.x, y: R.y, w: R.w, h }, eq ? col.ok() : undefined, eq ? 0.07 : 0);
+      title(R.x + pad, R.y + 16, ctx.t(isM ? 'distT' : 'armT'));
+      const maxV = Math.max(v1, v2, 1) * 1.05;
+      const nameW = W ? 46 : 42;
+      const valW = W ? 66 : 62;
+      const barW = R.w - 2 * pad - nameW - valW;
+      let y = R.y + (W ? 30 : 26);
+      [
+        [n1, v1, eq ? col.ok() : col.a()],
+        [n2, v2, eq ? col.ok() : col.b()],
+      ].forEach(([nm, v, c]) => {
+        const bh = W ? 12 : 10;
+        const yy = y + (W ? 13 : 11);
+        text(g, nm as string, R.x + pad, yy, { font: `700 ${W ? 13 : 12}px ${theme.font}`, color: c as string, align: 'left' });
+        const x0 = R.x + pad + nameW;
+        g.fillStyle = withAlpha(theme.text, 0.07);
+        roundRect(g, x0, yy - bh / 2, barW, bh, bh / 2);
+        g.fill();
+        g.fillStyle = c as string;
+        roundRect(g, x0, yy - bh / 2, Math.max(bh, ((v as number) / maxV) * barW), bh, bh / 2);
+        g.fill();
+        text(g, cmText(v as number, false), R.x + R.w - pad, yy, { font: f, color: theme.text, align: 'right' });
+        y += W ? 26 : 22;
+      });
+      y += 8;
+      const s = eq && eqPop.running ? Math.max(0.6, eqPop.value) : 1;
+      g.save();
+      g.translate(R.x + pad, y);
+      g.scale(s, s);
+      textRows(vRows, 0, 8.5, 17, `700 ${W ? 13 : 12}px ${theme.font}`, eq ? col.ok() : theme.text);
+      g.restore();
+      return h;
+    }
+
+    function textCard(R: Rect, head: string, body: string, accent?: string, maxH = Infinity): number {
+      const theme = ctx.theme;
+      const W = wide();
+      const pad = W ? 14 : 12;
+      const f = `500 ${W ? 12.5 : 12}px ${theme.font}`;
+      const lh = W ? 17 : 16;
+      const rows = wrap(body, R.w - 2 * pad, f);
+      const n = Math.min(rows.length, Math.floor((Math.min(R.h, maxH) - 40) / lh));
+      if (n <= 0) return 0;
+      const h = 32 + n * lh + 10;
+      card({ x: R.x, y: R.y, w: R.w, h }, accent, accent ? 0.04 : 0);
+      title(R.x + pad, R.y + 16, head, accent ?? theme.muted);
+      textRows(rows.slice(0, n), R.x + pad, R.y + 32 + lh / 2, lh, f, theme.text);
+      return h;
+    }
+
+    function traceCard(R: Rect): number {
+      const g = surface.g;
+      const theme = ctx.theme;
+      const W = wide();
+      const pad = W ? 14 : 12;
+      const list = mode() === 'mittel' ? traceM : traceW;
+      const f = `500 ${W ? 12 : 11.5}px ${theme.font}`;
+      const hint = wrap(ctx.t(mode() === 'mittel' ? 'traceHintM' : 'traceHintW'), R.w - 2 * pad, f);
+      const h = Math.min(R.h, 34 + 22 + hint.length * 15.5 + 8);
+      if (h < 60) return 0;
+      card({ x: R.x, y: R.y, w: R.w, h });
+      title(R.x + pad, R.y + 16, ctx.t('traceT'));
+      const y = R.y + 36;
+      g.beginPath();
+      g.arc(R.x + pad + 6, y, 5, 0, Math.PI * 2);
+      g.fillStyle = col.ok();
+      g.fill();
+      text(g, list.length ? tr('traceN', { n: list.length }) : ctx.t('trace0'), R.x + pad + 18, y, { font: `700 ${W ? 12.5 : 12}px ${theme.font}`, color: list.length ? theme.text : theme.muted, align: 'left' });
+      const n = Math.max(0, Math.floor((R.y + h - 8 - (y + 14)) / 15.5));
+      textRows(hint.slice(0, n), R.x + pad, y + 22, 15.5, f, theme.muted);
+      return h;
+    }
+
+    function stepsCard(R: Rect, compact: boolean): void {
+      const g = surface.g;
+      const theme = ctx.theme;
+      const W = wide();
+      const pad = W ? 14 : 12;
+      const list = steps();
+      const n = list.length - 1;
+      const done = stepIdx >= n && !stepRunning();
+      card(R, done ? col.ok() : col.line(), done ? 0.06 : 0.03);
+      title(R.x + pad, R.y + 16, ctx.t(constrWhat() === 'mittel' ? 'stepsTM' : 'stepsTW'), col.line());
+      const f = `500 ${W ? 12.5 : 12}px ${theme.font}`;
+      const fb = `700 ${W ? 12.5 : 12}px ${theme.font}`;
+      const lh = W ? 16.5 : 15.5;
+      const bh = 30;
+      const btnY = R.y + R.h - (W ? 12 : 10) - bh;
+      let y = R.y + (W ? 30 : 28);
+      if (compact) {
+        // Handy: nur der aktuelle Schritt mit Fortschrittspunkten
+        const dots = n;
+        for (let i = 1; i <= dots; i++) {
+          g.beginPath();
+          g.arc(R.x + pad + 5 + (i - 1) * 14, y + 6, 4.5, 0, Math.PI * 2);
+          g.fillStyle = i <= stepIdx ? col.line() : withAlpha(theme.text, 0.15);
+          g.fill();
+        }
+        text(g, stepIdx === 0 ? '' : tr('stepOf', { i: stepIdx, n }), R.x + R.w - pad, y + 6, { font: `600 11px ${theme.font}`, color: theme.muted, align: 'right' });
+        y += 20;
+        const rows = wrap(list[stepIdx]!.text, R.w - 2 * pad, fb);
+        y += textRows(rows, R.x + pad, y + lh / 2, lh, fb, theme.text) + 6;
+        if (done) {
+          const wr = wrap(ctx.t(constrWhat() === 'mittel' ? 'whyM' : 'whyW'), R.w - 2 * pad, f);
+          const k = Math.max(0, Math.floor((btnY - 6 - y) / lh));
+          textRows(wr.slice(0, k), R.x + pad, y + lh / 2, lh, f, theme.muted);
+        }
+      } else {
+        list.forEach((st, i) => {
+          const rows = wrap(st.text, R.w - 2 * pad - 28, i === stepIdx ? fb : f);
+          if (y + rows.length * lh > btnY - 6) return;
+          const state = i < stepIdx || (i === stepIdx && done) ? 'done' : i === stepIdx ? 'now' : 'todo';
+          const cy = y + lh / 2;
+          g.beginPath();
+          g.arc(R.x + pad + 10, cy, 10, 0, Math.PI * 2);
+          if (state === 'todo') {
+            g.strokeStyle = withAlpha(theme.text, 0.3);
+            g.lineWidth = 1.5;
+            g.stroke();
+          } else {
+            g.fillStyle = state === 'done' ? col.ok() : col.line();
+            g.fill();
+          }
+          text(g, state === 'done' ? '✓' : String(i), R.x + pad + 10, cy + 0.5, { font: `800 10.5px ${theme.font}`, color: state === 'todo' ? theme.muted : onColor() });
+          if (state === 'now') {
+            g.fillStyle = withAlpha(col.line(), theme.dark ? 0.14 : 0.08);
+            roundRect(g, R.x + pad + 24, y - 3, R.w - 2 * pad - 24, rows.length * lh + 6, 7);
+            g.fill();
+          }
+          textRows(rows, R.x + pad + 28, cy, lh, i === stepIdx ? fb : f, state === 'todo' ? theme.muted : theme.text);
+          y += rows.length * lh + 9;
+        });
+      }
+      if (!ctx.locked) {
+        g.font = `700 ${W ? 12.5 : 12}px ${theme.font}`;
+        const restartW = g.measureText(ctx.t('restart')).width + 26;
+        const nextW = g.measureText(ctx.t('next')).width + 30;
+        if (!done) button({ x: R.x + R.w - pad - nextW, y: btnY, w: nextW, h: bh }, ctx.t('next'), 'next', col.line(), true, !stepRunning());
+        else text(g, `✓ ${ctx.t('done')}`, R.x + R.w - pad, btnY + bh / 2, { font: `800 ${W ? 14 : 13}px ${theme.font}`, color: col.ok(), align: 'right' });
+        if (stepIdx > 0) button({ x: R.x + pad, y: btnY, w: restartW, h: bh }, ctx.t('restart'), 'restart', theme.muted);
+      }
+    }
+
+    function umkreisCard(R: Rect): number {
+      const g = surface.g;
+      const theme = ctx.theme;
+      const W = wide();
+      const pad = W ? 14 : 12;
+      const pts = [A(), B(), C()];
+      const u = collinear(pts[0]!, pts[1]!, pts[2]!) ? null : circumcenter(pts[0]!, pts[1]!, pts[2]!);
+      const f = `500 ${W ? 12.5 : 12}px ${theme.font}`;
+      const lh = W ? 17 : 16;
+      const rows = wrap(ctx.t(u ? 'uText' : 'uNone'), R.w - 2 * pad, f);
+      const k = triangleKind(pts[0]!, pts[1]!, pts[2]!);
+      const kRows = u ? wrap(ctx.t(k === 'spitz' ? 'uSpitz' : k === 'recht' ? 'uRecht' : 'uStumpf'), R.w - 2 * pad, `700 ${W ? 12.5 : 12}px ${theme.font}`) : [];
+      const h = 32 + rows.length * lh + (u ? 28 + kRows.length * lh : 0) + 12;
+      card({ x: R.x, y: R.y, w: R.w, h }, col.line(), 0.04);
+      title(R.x + pad, R.y + 16, ctx.t('uT'), col.line());
+      let y = R.y + 32;
+      y += textRows(rows, R.x + pad, y + lh / 2, lh, f, theme.text) + 6;
+      if (u) {
+        text(g, `|UA| = |UB| = |UC| ${cmText(dist(u, pts[0]!))}`, R.x + pad, y + 9, { font: `800 ${W ? 14 : 13}px ${theme.font}`, color: col.line(), align: 'left' });
+        y += 26;
+        textRows(kRows, R.x + pad, y + lh / 2, lh, `700 ${W ? 12.5 : 12}px ${theme.font}`, theme.text);
+      }
+      return h;
+    }
+
+    /* ---------- Rendern ---------- */
+    function render(): void {
+      hits = [];
+      surface.begin();
+      const lay = layout();
+      const g = surface.g;
+      drawPaper(lay.paper, lay.cell);
+      g.save();
+      roundRect(g, lay.paper.x, lay.paper.y, lay.paper.w, lay.paper.h, 10);
+      g.clip();
+      const m = mode();
+      if (m === 'mittel') drawMittel();
+      else if (m === 'winkel') drawWinkel();
+      else if (m === 'konstr') drawKonstr();
+      else drawUmkreis();
+      g.restore();
+      g.strokeStyle = ctx.theme.dark ? '#2a3445' : '#d5dce6';
+      g.lineWidth = 1;
+      roundRect(g, lay.paper.x + 0.5, lay.paper.y + 0.5, lay.paper.w - 1, lay.paper.h - 1, 10);
+      g.stroke();
+
+      const gap = wide() ? 10 : 8;
+      if (m === 'mittel' || m === 'winkel') {
+        const isM = m === 'mittel';
+        if (lay.side) {
+          let y = lay.side.y;
+          y += distCard({ ...lay.side, y }) + gap;
+          y += traceCard({ x: lay.side.x, y, w: lay.side.w, h: lay.side.y + lay.side.h - y }) + gap;
+          textCard({ x: lay.side.x, y, w: lay.side.w, h: lay.side.y + lay.side.h - y }, ctx.t('useT'), ctx.t(isM ? 'useM' : 'useW'));
+          textCard(lay.below, ctx.t('merkeT'), ctx.t(isM ? 'merkeM' : 'merkeW'), col.line());
+        } else {
+          let y = lay.below.y;
+          y += distCard({ ...lay.below, y }) + gap;
+          textCard({ x: lay.below.x, y, w: lay.below.w, h: lay.below.y + lay.below.h - y }, ctx.t('merkeT'), ctx.t(isM ? 'merkeM' : 'merkeW'), col.line());
+        }
+      } else if (m === 'konstr') {
+        if (lay.side) {
+          stepsCard(lay.side, false);
+          textCard(lay.below, ctx.t('why'), ctx.t(constrWhat() === 'mittel' ? 'whyM' : 'whyW'));
+        } else stepsCard(lay.below, true);
+      } else if (lay.side) {
+        const h = umkreisCard(lay.side);
+        textCard({ x: lay.side.x, y: lay.side.y + h + gap, w: lay.side.w, h: lay.side.h - h - gap }, ctx.t('useT'), ctx.t('uUse'));
+        textCard(lay.below, ctx.t('merkeT'), ctx.t('merkeM'), col.line());
+      } else umkreisCard(lay.below);
+
+      // Animationen
+      const running = m === 'konstr' && stepRunning();
+      if (m === 'konstr' && !running && autoPlay) {
+        if (stepIdx < steps().length - 1) {
+          const since = performance.now() - stepStart - stepDur(steps()[stepIdx]!);
+          if (since > 350) nextStep();
+        } else autoPlay = false;
+      }
+      if (running || autoPlay || tracePop.running || eqPop.running) ctx.requestRender();
+      if (m === 'konstr' && wasRunning && !running) updateReadouts();
+      wasRunning = running;
+    }
+    let wasRunning = false;
+
+    /* ---------- Zeiger ---------- */
+    const canDrag = () => !ctx.locked && !(mode() === 'konstr' && (stepRunning() || autoPlay));
+
+    function hitAt(px: number, py: number): string | null {
+      for (let i = hits.length - 1; i >= 0; i--) {
+        const h = hits[i]!;
+        if (px >= h.r.x && px <= h.r.x + h.r.w && py >= h.r.y && py <= h.r.y + h.r.h) return h.id;
+      }
+      if (!canDrag()) return null;
+      const R = wide() ? 18 : 22;
+      const cands: [string, Pt][] = [];
+      const m = mode();
+      if (m === 'mittel') cands.push(['p', P], ['a', A()], ['b', B()]);
+      else if (m === 'winkel') {
+        const an = angle();
+        cands.push(['p', PW], ['s', an.s]);
+        for (const which of [1, 2] as const) {
+          const th = which === 1 ? an.th1 : an.th1 + an.al;
+          const t = armHandleDist(th);
+          const u = dir(th);
+          cands.push([`arm${which}`, [an.s[0] + u[0] * t, an.s[1] + u[1] * t]]);
+        }
+      } else if (m === 'konstr') {
+        if (constrWhat() === 'mittel') cands.push(['a', A()], ['b', B()]);
+        else {
+          const an = angle();
+          cands.push(['s', an.s]);
+          for (const which of [1, 2] as const) {
+            const th = which === 1 ? an.th1 : an.th1 + an.al;
+            const t = armHandleDist(th);
+            const u = dir(th);
+            cands.push([`arm${which}`, [an.s[0] + u[0] * t, an.s[1] + u[1] * t]]);
+          }
+        }
+      } else cands.push(['a', A()], ['b', B()], ['c', C()]);
+      let best: string | null = null;
+      let bd = R;
+      for (const [id, q] of cands) {
+        const [x, y] = toPx(q);
+        const d = Math.hypot(px - x, py - y);
+        if (d < bd) {
+          bd = d;
+          best = id;
+        }
+      }
+      return best;
+    }
+
+    function tap(id: string): void {
+      if (ctx.locked) return;
+      if (id === 'next') {
+        autoPlay = false;
+        nextStep();
+      } else if (id === 'restart') restart();
+      ctx.requestRender();
+    }
+
+    function setPoint(id: 'a' | 'b' | 'c' | 's', q: Pt): void {
+      const s = snap(q);
+      if (id === 's') {
+        ctx.set({ sx: s[0], sy: s[1] });
+        return;
+      }
+      const others = (['a', 'b', 'c'] as const).filter((k) => k !== id && (k !== 'c' || mode() === 'umkreis'));
+      const pos: Record<string, Pt> = { a: A(), b: B(), c: C() };
+      if (others.some((k) => pos[k]![0] === s[0] && pos[k]![1] === s[1])) return;
+      ctx.set({ [`${id}x`]: s[0], [`${id}y`]: s[1] });
+    }
+
+    surface.addTarget({
+      contains: (px: number, py: number) => drag !== null || hitAt(px, py) !== null,
+      pointerDown: (q: { px: number; py: number }) => {
+        const id = hitAt(q.px, q.py);
+        if (!id) return false;
+        if (id === 'p') drag = { kind: 'p' };
+        else if (id === 'a' || id === 'b' || id === 'c' || id === 's') drag = { kind: 'pt', id };
+        else if (id === 'arm1' || id === 'arm2') drag = { kind: 'arm', which: id === 'arm1' ? 1 : 2 };
+        else {
+          tap(id);
+          return true;
+        }
+        surface.setCursor('grabbing');
+        ctx.requestRender();
+        return true;
+      },
+      pointerMove: (q: { px: number; py: number }) => {
+        if (!drag || !canDrag()) return;
+        const w = toWorld(q.px, q.py);
+        if (drag.kind === 'p') {
+          if (mode() === 'mittel') P = snap(w);
+          else placePW(w);
+          checkEqual();
+          updateReadouts();
+        } else if (drag.kind === 'pt') setPoint(drag.id, w);
+        else {
+          const an = angle();
+          let deg = Math.round((Math.atan2(w[1] - an.s[1], w[0] - an.s[0]) * 180) / Math.PI);
+          deg = norm360(deg);
+          if (drag.which === 1) {
+            // erster Schenkel dreht, zweiter bleibt liegen
+            const th2 = an.th1 + an.al;
+            let al = norm360(th2 - deg);
+            al = clamp(al, 20, 180);
+            ctx.set({ th: Math.round(norm360(th2 - al)) % 360, al: Math.round(al) });
+          } else {
+            const al = clamp(norm360(deg - an.th1), 20, 180);
+            ctx.set({ al: Math.round(al) });
+          }
+        }
+        ctx.requestRender();
+      },
+      pointerUp: () => {
+        drag = null;
+        surface.setCursor('');
+        ctx.requestRender();
+      },
+      hover: (q: { px: number; py: number } | null) => {
+        const id = q ? hitAt(q.px, q.py) : null;
+        if (id !== hover) {
+          hover = id;
+          ctx.requestRender();
+        }
+        surface.setCursor(!id ? '' : id === 'next' || id === 'restart' ? 'pointer' : 'grab');
+      },
+      wheel: () => false,
+    });
+
+    function resetP(): void {
+      // P neben die Ortslinie legen
+      const a = A();
+      const b = B();
+      const { m, d } = perpBisector(a, b);
+      const off: Pt = [(a[0] - m[0]) * 0.5 + d[0] * 2.5, (a[1] - m[1]) * 0.5 + d[1] * 2.5];
+      P = snap([m[0] + off[0], m[1] + off[1]]);
+      if (closer(P, a, b) === 'equal') P = snap([P[0] + (a[0] < b[0] ? -1 : 1), P[1]]);
+      const an = angle();
+      const u = dir(an.th1 + an.al * 0.3);
+      placePW([an.s[0] + u[0] * 6, an.s[1] + u[1] * 6]);
+      lastEq = false;
+    }
+    resetP();
+
+    return {
+      update(changed, source) {
+        const abChanged = ['ax', 'ay', 'bx', 'by'].some((k) => changed.has(k));
+        const angChanged = ['sx', 'sy', 'th', 'al'].some((k) => changed.has(k));
+        if (abChanged) traceM = [];
+        if (angChanged) {
+          traceW = [];
+          placePW(PW);
+        }
+        if (source === 'replace' || source === 'init' || changed.has('mode')) {
+          resetP();
+          traceM = [];
+          traceW = [];
+        }
+        if (abChanged || angChanged || changed.has('what') || changed.has('mode') || source === 'replace') restart();
+        if (changed.has('trace') && !p.trace) {
+          traceM = [];
+          traceW = [];
+        }
+        checkEqual();
+        updateReadouts();
+      },
+
+      action(id) {
+        if (ctx.locked) return;
+        if (id === 'next') {
+          autoPlay = false;
+          nextStep();
+        } else if (id === 'play') {
+          if (stepIdx >= steps().length - 1) restart();
+          autoPlay = true;
+          if (!stepRunning()) nextStep();
+        } else if (id === 'restart') restart();
+        else if (id === 'clear') {
+          traceM = [];
+          traceW = [];
+        }
+        updateReadouts();
+        ctx.requestRender();
+      },
+
+      render,
+      destroy: () => surface.destroy(),
+    };
+  },
+});
