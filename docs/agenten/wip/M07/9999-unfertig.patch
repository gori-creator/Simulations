+      return [...list, q];
+    }
+
+    function checkEqual(): void {
+      const eq = mode() === 'mittel' ? closer(P, A(), B()) === 'equal' : mode() === 'winkel' ? onW() : false;
+      if (eq && !lastEq) eqPop.play();
+      lastEq = eq;
+      if (eq && p.trace) {
+        if (mode() === 'mittel') traceM = addTrace(traceM, P);
+        else traceW = addTrace(traceW, PW);
+      }
