+      if (st.line) {
+        const a = toPx(st.line.a);
+        const b = toPx(st.line.b);
+        const e: [number, number] = [a[0] + (b[0] - a[0]) * st.line.t, a[1] + (b[1] - a[1]) * st.line.t];
+        segment(a, e, col.line(), 2.8);
+        if (st.line.t >= 1) {
+          const lab = isM ? 'm' : 'w';
+          const [ux, uy] = unit(b[0] - a[0], b[1] - a[1]);
+          haloText(lab, b[0] - ux * 14 + 12, b[1] - uy * 14, `italic 700 ${W ? 18 : 16}px ${theme.mathFont}`, col.line());
