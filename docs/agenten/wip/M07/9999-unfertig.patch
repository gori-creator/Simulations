+        g.beginPath();
+        g.arc(pm[0], pm[1], 2.8, 0, Math.PI * 2);
+        g.fillStyle = colors[k]!;
+        g.fill();
+      });
+      // Umkreis
+      if (u) {
+        const pu = toPx(u);
+        const r = dist(u, pts[0]!) * layout().cell;
+        if (p.circ) {
+          g.beginPath();
+          g.arc(pu[0], pu[1], r, 0, Math.PI * 2);
+          g.strokeStyle = col.line();
+          g.lineWidth = 2.6;
+          g.stroke();
