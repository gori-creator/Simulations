+        g.fill();
+        g.strokeStyle = col.line();
+        g.lineWidth = 2.6;
+        g.stroke();
+        g.beginPath();
+        g.arc(pu[0], pu[1], 2.6, 0, Math.PI * 2);
+        g.fillStyle = col.line();
+        g.fill();
+        haloText('U', pu[0] + 13, pu[1] - 13, `800 ${W ? 15 : 13}px ${theme.font}`, col.line(), 'left');
+      }
+      // Seiten
+      g.save();
+      g.beginPath();
+      px.forEach(([x, y], i) => (i ? g.lineTo(x, y) : g.moveTo(x, y)));
