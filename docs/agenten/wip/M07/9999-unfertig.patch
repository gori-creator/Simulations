+    /* ---------- Modus: Konstruktion ---------- */
+    function drawCompass(c: NonNullable<CState['compass']>): void {
+      const g = surface.g;
+      const theme = ctx.theme;
+      const { cell } = layout();
+      const pin = toPx(c.pin);
+      const u = dir(c.ang);
+      const pen = toPx([c.pin[0] + u[0] * c.r, c.pin[1] + u[1] * c.r]);
+      const rpx = c.r * cell;
+      const Lg = Math.max(rpx * 0.62 + 36, rpx / 2 + 24);
+      const half = rpx / 2;
+      const h = Math.sqrt(Math.max(0, Lg * Lg - half * half));
+      const base: [number, number] = [(pin[0] + pen[0]) / 2, (pin[1] + pen[1]) / 2];
+      const [dx, dy] = unit(pen[0] - pin[0], pen[1] - pin[1]);
+      // Seite des Gelenks: so, dass es beim Bezugswinkel nach oben zeigt (kein Umspringen während eines Bogens)
+      const ur = dir(c.ref);
+      const nRef: [number, number] = [ur[1], ur[0]]; // Pixelrichtung von rot90
+      const side = -nRef[1] <= 0 ? 1 : -1;
+      const n: [number, number] = [dy * side, -dx * side];
+      const hinge: [number, number] = [base[0] + n[0] * h, base[1] + n[1] * h];
+      g.save();
+      g.globalAlpha = c.alpha;
+      const metalA = theme.dark ? '#d5dde8' : '#8e9aab';
+      const metalB = theme.dark ? '#8f9bad' : '#4f5a6b';
+      // Schatten
+      g.save();
+      g.shadowColor = theme.dark ? 'rgba(0,0,0,0.6)' : 'rgba(16,24,40,0.28)';
+      g.shadowBlur = 12;
+      g.shadowOffsetX = 4;
+      g.shadowOffsetY = 6;
+      g.strokeStyle = metalB;
+      g.lineCap = 'round';
+      g.lineWidth = 7;
+      g.beginPath();
+      g.moveTo(hinge[0], hinge[1]);
+      g.lineTo(pin[0] + (hinge[0] - pin[0]) * 0.16, pin[1] + (hinge[1] - pin[1]) * 0.16);
+      g.moveTo(hinge[0], hinge[1]);
+      g.lineTo(pen[0] + (hinge[0] - pen[0]) * 0.3, pen[1] + (hinge[1] - pen[1]) * 0.3);
+      g.stroke();
+      g.restore();
+      const leg = (to: [number, number], cut: number) => {
+        const end: [number, number] = [to[0] + (hinge[0] - to[0]) * cut, to[1] + (hinge[1] - to[1]) * cut];
+        const grad = g.createLinearGradient(hinge[0] - n[1] * 4, hinge[1] + n[0] * 4, hinge[0] + n[1] * 4, hinge[1] - n[0] * 4);
